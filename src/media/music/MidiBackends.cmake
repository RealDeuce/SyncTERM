find_package(PkgConfig QUIET)
function(st_midi_is_archive path result)
	set(${result} FALSE PARENT_SCOPE)
	file(READ "${path}" magic LIMIT 8 HEX)
	if(magic STREQUAL "213c617263683e0a" OR magic STREQUAL "213c7468696e3e0a")
		set(${result} TRUE PARENT_SCOPE)
		return()
	endif()
	# Mach-O universal static libraries contain an ar archive in each slice.
	# A universal dylib has the same outer magic, so inspect the slices too.
	string(LENGTH "${magic}" magic_length)
	if(magic_length LESS 16)
		return()
	endif()
	string(SUBSTRING "${magic}" 0 8 format)
	if(NOT format STREQUAL "cafebabe" AND NOT format STREQUAL "cafebabf")
		return()
	endif()
	string(SUBSTRING "${magic}" 8 8 count_hex)
	math(EXPR count "0x${count_hex}")
	if(count LESS 1 OR count GREATER 1024)
		return()
	endif()
	set(entry 20)
	set(offset_bytes 4)
	if(format STREQUAL "cafebabf")
		set(entry 32)
		set(offset_bytes 8)
	endif()
	math(EXPR header "8 + ${count} * ${entry}")
	file(SIZE "${path}" size)
	if(size LESS header)
		return()
	endif()
	math(EXPR last "${count} - 1")
	math(EXPR end "${size} - 8")
	foreach(i RANGE 0 ${last})
		math(EXPR pos "16 + ${i} * ${entry}")
		file(READ "${path}" offset_hex OFFSET ${pos} LIMIT ${offset_bytes} HEX)
		math(EXPR offset "0x${offset_hex}")
		if(offset LESS header OR offset GREATER end)
			return()
		endif()
		file(READ "${path}" slice OFFSET ${offset} LIMIT 8 HEX)
		if(NOT slice STREQUAL "213c617263683e0a" AND NOT slice STREQUAL "213c7468696e3e0a")
			return()
		endif()
	endforeach()
	set(${result} TRUE PARENT_SCOPE)
endfunction()
function(st_midi_dependency name package header symbols library definitions)
	set(ST_MIDI_${name} AUTO CACHE STRING "${name} MIDI linkage (AUTO, RUNTIME, STATIC, OFF)")
	set_property(CACHE ST_MIDI_${name} PROPERTY STRINGS AUTO RUNTIME STATIC OFF)
	if(NOT ST_MIDI_${name} MATCHES "^(AUTO|RUNTIME|STATIC|OFF)$")
		message(FATAL_ERROR "ST_MIDI_${name} must be AUTO, RUNTIME, STATIC, or OFF")
	endif()
	set(ST_MIDI_LINK_${name} 0 PARENT_SCOPE)
	if(ST_MIDI_${name} STREQUAL "OFF")
		return()
	endif()
	# Native Windows/macOS policy precedes the two portable synthesizers;
	# ALSA environment routing belongs to the other POSIX targets.
	if(name STREQUAL "ALSA" AND (WIN32 OR APPLE))
		if(NOT ST_MIDI_${name} STREQUAL "AUTO")
			message(FATAL_ERROR "ALSA MIDI routing is available on non-Apple POSIX targets")
		endif()
		return()
	endif()
	if(PkgConfig_FOUND)
		pkg_check_modules(MIDI_${name}_PC QUIET ${package})
	endif()
	find_path(ST_MIDI_${name}_INCLUDE_DIR ${header} HINTS ${MIDI_${name}_PC_INCLUDE_DIRS})
	set(ST_MIDI_${name}_HEADERS FALSE)
	if(ST_MIDI_${name}_INCLUDE_DIR)
		set(CMAKE_REQUIRED_INCLUDES ${ST_MIDI_${name}_INCLUDE_DIR} ${CMAKE_CURRENT_FUNCTION_LIST_DIR})
		set(CMAKE_REQUIRED_DEFINITIONS ${definitions})
		set(probe "#include <${header}>\n#include \"${symbols}_symbols.h\"\n#define X(r,n,a) r (*p_##n) a = n;\nST_${symbols}_SYMBOLS(X)\nint main(void) { return 0; }\n")
		# Symbol headers use uppercase macro names and lowercase filenames.
		string(TOUPPER "${symbols}" macro)
		string(REPLACE "ST_${symbols}_SYMBOLS" "ST_${macro}_SYMBOLS" probe "${probe}")
		set(saved_try_type "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
		set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
		string(SHA256 signature "${probe};${CMAKE_REQUIRED_INCLUDES};${definitions}")
		syncterm_check_c17_source("${probe}" ST_MIDI_HEADERS_${signature})
		set(ST_MIDI_${name}_HEADERS ${ST_MIDI_HEADERS_${signature}})
		if(saved_try_type)
			set(CMAKE_TRY_COMPILE_TARGET_TYPE "${saved_try_type}")
		else()
			unset(CMAKE_TRY_COMPILE_TARGET_TYPE)
		endif()
	endif()
	if(NOT ST_MIDI_${name}_HEADERS)
		if(NOT ST_MIDI_${name} STREQUAL "AUTO")
			message(FATAL_ERROR "ST_MIDI_${name}=${ST_MIDI_${name}} requires usable ${header} development headers")
		endif()
		return()
	endif()
	add_library(st_midi_${name}_dependency INTERFACE)
	target_include_directories(st_midi_${name}_dependency SYSTEM INTERFACE ${ST_MIDI_${name}_INCLUDE_DIR})
	if(ST_MIDI_${name} STREQUAL "STATIC")
		set(upstream)
		if(name STREQUAL "ADLMIDI")
			find_package(libADLMIDI CONFIG QUIET)
			set(candidate libADLMIDI::ADLMIDI_static)
		elseif(name STREQUAL "FLUIDSYNTH")
			find_package(FluidSynth CONFIG QUIET)
			set(candidate FluidSynth::libfluidsynth)
		else()
			set(candidate "")
		endif()
		if(TARGET "${candidate}")
			get_target_property(type "${candidate}" TYPE)
			if(type STREQUAL "STATIC_LIBRARY")
				get_target_property(configs "${candidate}" IMPORTED_CONFIGURATIONS)
				foreach(config "" ${configs})
					if(config)
						set(property IMPORTED_LOCATION_${config})
					else()
						set(property IMPORTED_LOCATION)
					endif()
					get_target_property(location "${candidate}" "${property}")
					if(location)
						if(NOT ST_MIDI_${name}_ARCHIVE)
							set(ST_MIDI_${name}_ARCHIVE "${location}" CACHE FILEPATH "${name} static archive" FORCE)
						endif()
						if(ST_MIDI_${name}_ARCHIVE STREQUAL location)
							set(upstream "${candidate}")
						endif()
						break()
					endif()
				endforeach()
			endif()
		endif()
		# Scope suffix changes to this function: other dependencies retain their
		# own linkage policy. A shared library is never a substitute here.
		if(WIN32)
			set(CMAKE_FIND_LIBRARY_SUFFIXES .a .lib)
		else()
			set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
		endif()
		find_library(ST_MIDI_${name}_ARCHIVE NAMES ${library} HINTS ${MIDI_${name}_PC_LIBRARY_DIRS})
		if(NOT ST_MIDI_${name}_ARCHIVE OR NOT EXISTS "${ST_MIDI_${name}_ARCHIVE}"
		    OR ST_MIDI_${name}_ARCHIVE MATCHES "\\.dll\\.a$")
			message(FATAL_ERROR "ST_MIDI_${name}=STATIC requires a real ${library} archive")
		endif()
		st_midi_is_archive("${ST_MIDI_${name}_ARCHIVE}" archive)
		if(NOT archive)
			message(FATAL_ERROR "${ST_MIDI_${name}_ARCHIVE} is not a static archive")
		endif()
		if(WIN32)
			file(STRINGS "${ST_MIDI_${name}_ARCHIVE}" imports REGEX "__IMPORT_DESCRIPTOR_" LIMIT_COUNT 1)
			if(imports)
				message(FATAL_ERROR "${ST_MIDI_${name}_ARCHIVE} is an import library, not a static MIDI library")
			endif()
		endif()
		# pkg-config --static supplies private dependencies. Resolve these with
		# normal suffixes; requesting one archive does not make the app static.
		set(CMAKE_FIND_LIBRARY_SUFFIXES ${_ST_MIDI_NORMAL_SUFFIXES})
		set(closure)
		foreach(dep IN LISTS MIDI_${name}_PC_STATIC_LIBRARIES)
			if(NOT dep STREQUAL library)
				unset(found CACHE)
				find_library(found NAMES ${dep} HINTS ${MIDI_${name}_PC_STATIC_LIBRARY_DIRS})
				if(NOT found)
					message(FATAL_ERROR "Missing static ${name} dependency: ${dep}")
				endif()
				list(APPEND closure "${found}")
			endif()
		endforeach()
		set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
		add_library(st_midi_${name}_archive STATIC IMPORTED)
		set_target_properties(st_midi_${name}_archive PROPERTIES IMPORTED_LOCATION "${ST_MIDI_${name}_ARCHIVE}"
			INTERFACE_LINK_LIBRARIES "${closure}" INTERFACE_LINK_OPTIONS "${MIDI_${name}_PC_STATIC_LDFLAGS_OTHER}")
		set(CMAKE_REQUIRED_LIBRARIES st_midi_${name}_archive)
		if(upstream)
			set(CMAKE_REQUIRED_LIBRARIES "${upstream}")
		endif()
		set(CMAKE_REQUIRED_LINK_OPTIONS ${MIDI_${name}_PC_STATIC_LDFLAGS_OTHER})
		string(SHA256 signature "${probe};${ST_MIDI_${name}_ARCHIVE};${closure};${CMAKE_REQUIRED_LINK_OPTIONS}")
		if(name STREQUAL "ADLMIDI" OR name STREQUAL "FLUIDSYNTH")
			set_target_properties(st_midi_${name}_archive PROPERTIES IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
			include(CheckCXXSourceCompiles)
			check_cxx_source_compiles("${probe}" ST_MIDI_LINKS_${signature})
		else()
			syncterm_check_c17_source("${probe}" ST_MIDI_LINKS_${signature})
		endif()
		if(NOT ST_MIDI_LINKS_${signature})
			message(FATAL_ERROR "Static ${name} archive cannot link its required API and transitive dependencies")
		endif()
		target_link_libraries(st_midi_${name}_dependency INTERFACE ${CMAKE_REQUIRED_LIBRARIES})
		if(name STREQUAL "ADLMIDI" OR name STREQUAL "FLUIDSYNTH")
			# Like st_crypto's C ABI, these archives can reach C-only
			# consumers outside the directory enabling CXX. Carry the
			# toolchain's detected runtime closure across that boundary.
			target_link_libraries(st_midi_${name}_dependency INTERFACE ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
			target_link_directories(st_midi_${name}_dependency INTERFACE ${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES})
		endif()
		foreach(def IN LISTS definitions)
			string(REGEX REPLACE "^-D" "" def "${def}")
			target_compile_definitions(st_midi_${name}_dependency INTERFACE "${def}")
		endforeach()
		set(ST_MIDI_LINK_${name} 2 PARENT_SCOPE)
	else()
		set(ST_MIDI_LINK_${name} 1 PARENT_SCOPE)
	endif()
	set(_st_midi_deps ${_st_midi_deps} st_midi_${name}_dependency PARENT_SCOPE)
endfunction()
set(_ST_MIDI_NORMAL_SUFFIXES ${CMAKE_FIND_LIBRARY_SUFFIXES})
st_midi_dependency(ALSA alsa alsa/asoundlib.h alsa asound "")
if(ST_MIDI_ADLMIDI STREQUAL "STATIC" OR ST_MIDI_FLUIDSYNTH STREQUAL "STATIC")
	# Static synthesizer implementations require their C++ linker/runtime.
	# Runtime-loaded adapters remain C17 and do not require a C++ compiler.
	enable_language(CXX)
endif()
st_midi_dependency(FLUIDSYNTH fluidsynth fluidsynth.h fluid fluidsynth "-DFLUIDSYNTH_NOT_A_DLL")
st_midi_dependency(ADLMIDI libADLMIDI adlmidi.h adl ADLMIDI "-DADLMIDI_STATIC")

foreach(name WINMM APPLE)
	set(ST_MIDI_${name} AUTO CACHE STRING "System ${name} MIDI support (AUTO, ON, OFF)")
	set_property(CACHE ST_MIDI_${name} PROPERTY STRINGS AUTO ON OFF)
	if(NOT ST_MIDI_${name} MATCHES "^(AUTO|ON|OFF)$")
		message(FATAL_ERROR "ST_MIDI_${name} must be AUTO, ON, or OFF")
	endif()
	set(ST_MIDI_LINK_${name} 0)
endforeach()
if(WIN32 AND NOT ST_MIDI_WINMM STREQUAL "OFF")
	set(CMAKE_REQUIRED_LIBRARIES winmm)
	syncterm_check_c17_source("#include <windows.h>\n#include <mmsystem.h>\nint main(void) { HMIDIOUT h = 0; MIDIHDR b = {0}; UINT id; MIDIOUTCAPSW caps; return midiOutOpen(&h, MIDI_MAPPER, 0, 0, CALLBACK_NULL) + midiOutShortMsg(h, 0) + midiOutLongMsg(h, &b, sizeof(b)) + midiOutPrepareHeader(h, &b, sizeof(b)) + midiOutUnprepareHeader(h, &b, sizeof(b)) + midiOutGetID(h, &id) + midiOutGetDevCapsW(id, &caps, sizeof(caps)) + midiOutSetVolume(h, 0) + midiOutReset(h) + midiOutClose(h); }" ST_MIDI_WINMM_WORKS)
	if(ST_MIDI_WINMM_WORKS)
		set(ST_MIDI_LINK_WINMM 3)
		list(APPEND _st_midi_deps winmm)
	endif()
endif()
if(APPLE AND NOT ST_MIDI_APPLE STREQUAL "OFF")
	find_library(ST_MIDI_AUDIO_TOOLBOX AudioToolbox)
	find_library(ST_MIDI_AUDIO_UNIT AudioUnit)
	set(CMAKE_REQUIRED_LIBRARIES ${ST_MIDI_AUDIO_TOOLBOX} ${ST_MIDI_AUDIO_UNIT})
	syncterm_check_c17_source("#include <AudioToolbox/AudioToolbox.h>\n#include <AudioUnit/AudioUnit.h>\nint main(void) { AudioComponentDescription d = {0}; d.componentType = kAudioUnitType_MusicDevice; d.componentSubType = kAudioUnitSubType_DLSSynth; AudioComponent c = AudioComponentFindNext(0, &d); AudioUnit u = 0; AudioTimeStamp t = {0}; AudioUnitRenderActionFlags f = 0; AudioBufferList b = {0}; return AudioComponentInstanceNew(c, &u) + AudioComponentInstanceDispose(u) + AudioUnitInitialize(u) + AudioUnitUninitialize(u) + AudioUnitSetProperty(u, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Output, 0, &t, sizeof(t)) + AudioUnitRender(u, &f, &t, 0, 0, &b) + MusicDeviceMIDIEvent(u, 0, 0, 0, 0) + MusicDeviceSysEx(u, (const UInt8 *)\"\", 0); }" ST_MIDI_APPLE_WORKS)
	if(ST_MIDI_APPLE_WORKS)
		set(ST_MIDI_LINK_APPLE 3)
		list(APPEND _st_midi_deps ${ST_MIDI_AUDIO_TOOLBOX} ${ST_MIDI_AUDIO_UNIT})
	endif()
endif()
foreach(name WINMM APPLE)
	if(ST_MIDI_${name} STREQUAL "ON" AND NOT ST_MIDI_LINK_${name})
		message(FATAL_ERROR "Requested ${name} MIDI API is unavailable")
	endif()
endforeach()
