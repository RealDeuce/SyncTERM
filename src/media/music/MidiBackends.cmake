include("${CMAKE_CURRENT_LIST_DIR}/../../../cmake/SynctermDependencies.cmake")
function(st_midi_dependency name package header symbols library definitions)
	set(ST_MIDI_${name} AUTO CACHE STRING "${name} MIDI support (AUTO, ON, OFF)")
	set_property(CACHE ST_MIDI_${name} PROPERTY STRINGS AUTO ON OFF)
	if(NOT ST_MIDI_${name} MATCHES "^(AUTO|ON|OFF)$")
		message(FATAL_ERROR "ST_MIDI_${name} now selects AUTO/ON/OFF; use ST_DEP_${name}_LINKAGE for linkage")
	endif()
	syncterm_dependency_options(${name} RUNTIME)
	set(ST_MIDI_LINK_${name} 0 PARENT_SCOPE)
	if(ST_MIDI_${name} STREQUAL "OFF")
		return()
	endif()
	if((WIN32 OR APPLE) AND ST_MIDI_${name} STREQUAL "AUTO")
		return()
	endif()
	if(name STREQUAL "ALSA" AND (WIN32 OR APPLE))
		message(FATAL_ERROR "ALSA MIDI routing is unavailable on this target")
	endif()
	string(TOUPPER "${symbols}" macro)
	set(probe "#include <${header}>\n#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${symbols}_symbols.h\"\n#define X(r,n,a) r (*p_##n) a = n;\nST_${macro}_SYMBOLS(X)\nint main(void) { return 0; }\n")
	set(required)
	if(ST_MIDI_${name} STREQUAL "ON" OR NOT ST_DEP_${name}_LINKAGE STREQUAL "AUTO" OR NOT ST_DEP_${name}_SOURCE STREQUAL "AUTO")
		set(required REQUIRED)
	endif()
	set(cxx)
	if(NOT ST_DEP_${name}_MODE STREQUAL "RUNTIME" AND NOT name STREQUAL "ALSA")
		set(cxx CXX)
	endif()
	syncterm_dependency(NAME ${name} PACKAGE ${package} HEADER ${header}
		LIBRARIES ${library} DEFAULT RUNTIME ${required} ${cxx}
		DEFINITIONS ${definitions} PROBE "${probe}")
	if(ST_DEP_${name}_TARGET)
		if(ST_DEP_${name}_MODE STREQUAL "STATIC")
			set(link 2)
		elseif(ST_DEP_${name}_MODE STREQUAL "SHARED")
			set(link 4)
		else()
			set(link 1)
		endif()
		set(ST_MIDI_LINK_${name} ${link} PARENT_SCOPE)
		set(_st_midi_deps ${_st_midi_deps} ${ST_DEP_${name}_TARGET} PARENT_SCOPE)
	endif()
endfunction()
st_midi_dependency(ALSA alsa alsa/asoundlib.h alsa asound "")
st_midi_dependency(FLUIDSYNTH fluidsynth fluidsynth.h fluid fluidsynth "-DFLUIDSYNTH_NOT_A_DLL")
st_midi_dependency(ADLMIDI libADLMIDI adlmidi.h adl ADLMIDI "-DADLMIDI_STATIC")

foreach(name WINMM APPLE)
	set(ST_MIDI_${name} AUTO CACHE STRING "System ${name} MIDI support (AUTO, ON, OFF)")
	set_property(CACHE ST_MIDI_${name} PROPERTY STRINGS AUTO ON OFF)
	if(NOT ST_MIDI_${name} MATCHES "^(AUTO|ON|OFF)$")
		message(FATAL_ERROR "ST_MIDI_${name} must be AUTO, ON, or OFF")
	endif()
	set(ST_MIDI_LINK_${name} 0)
endforeach()
if(WIN32 AND NOT ST_MIDI_WINMM STREQUAL "OFF")
	set(CMAKE_REQUIRED_LIBRARIES winmm)
	syncterm_check_c17_source("#include <windows.h>\n#include <mmsystem.h>\nint main(void) { HMIDIOUT h = 0; MIDIHDR b = {0}; UINT id; MIDIOUTCAPSW caps; return midiOutOpen(&h, MIDI_MAPPER, 0, 0, CALLBACK_NULL) + midiOutShortMsg(h, 0) + midiOutLongMsg(h, &b, sizeof(b)) + midiOutPrepareHeader(h, &b, sizeof(b)) + midiOutUnprepareHeader(h, &b, sizeof(b)) + midiOutGetID(h, &id) + midiOutGetDevCapsW(id, &caps, sizeof(caps)) + midiOutSetVolume(h, 0) + midiOutReset(h) + midiOutClose(h); }" ST_MIDI_WINMM_WORKS)
	if(ST_MIDI_WINMM_WORKS)
		set(ST_MIDI_LINK_WINMM 3)
		list(APPEND _st_midi_deps winmm)
	endif()
endif()
if(APPLE AND NOT ST_MIDI_APPLE STREQUAL "OFF")
	find_library(ST_MIDI_AUDIO_TOOLBOX AudioToolbox)
	find_library(ST_MIDI_AUDIO_UNIT AudioUnit)
	set(CMAKE_REQUIRED_LIBRARIES ${ST_MIDI_AUDIO_TOOLBOX} ${ST_MIDI_AUDIO_UNIT})
	syncterm_check_c17_source("#include <AudioToolbox/AudioToolbox.h>\n#include <AudioUnit/AudioUnit.h>\nint main(void) { AudioComponentDescription d = {0}; d.componentType = kAudioUnitType_MusicDevice; d.componentSubType = kAudioUnitSubType_DLSSynth; AudioComponent c = AudioComponentFindNext(0, &d); AudioUnit u = 0; AudioTimeStamp t = {0}; AudioUnitRenderActionFlags f = 0; AudioBufferList b = {0}; return AudioComponentInstanceNew(c, &u) + AudioComponentInstanceDispose(u) + AudioUnitInitialize(u) + AudioUnitUninitialize(u) + AudioUnitSetProperty(u, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Output, 0, &t, sizeof(t)) + AudioUnitRender(u, &f, &t, 0, 0, &b) + MusicDeviceMIDIEvent(u, 0, 0, 0, 0) + MusicDeviceSysEx(u, (const UInt8 *)\"\", 0); }" ST_MIDI_APPLE_WORKS)
	if(ST_MIDI_APPLE_WORKS)
		set(ST_MIDI_LINK_APPLE 3)
		list(APPEND _st_midi_deps ${ST_MIDI_AUDIO_TOOLBOX} ${ST_MIDI_AUDIO_UNIT})
	endif()
endif()
foreach(name WINMM APPLE)
	if(ST_MIDI_${name} STREQUAL "ON" AND NOT ST_MIDI_LINK_${name})
		message(FATAL_ERROR "Requested ${name} MIDI API is unavailable")
	endif()
endforeach()
