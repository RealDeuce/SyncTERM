{
  "schema_version": 1,
  "target": "IGS221/IG221.ACC serial / intended US TOS 1.04 software graphics",
  "reference_root": "~/IGS/docs/igs/",
  "contract": {
    "pixel_fidelity": "exact for intended valid operations",
    "audio": "functional synthesis and playback tests; manual listening after implementation; no PCM/reference comparison gate",
    "bugs": "safe documented corrections; no memory corruption or accidental overflow emulation",
    "older_profiles": false,
    "big_condor_implementations": false,
    "framebuffer": {
      "screen": "existing SyncTERM bitmap framebuffer; palette-indexed IGS pixels; no persistent planar framebuffer or shadow",
      "memory_images": "indexed pixels preserving full decoded capacity, padding and retained data, with plane-layout and row-stride metadata",
      "conversion": "decode at import; encode when native bytes are required; repack/reinterpret at plane-layout changes, not at ordinary blits",
      "raster_operations": "G Boolean operations on physical colour indices; row-stride changes can be views; X14 changes routing only"
    },
    "video_wait_units_per_second": 60,
    "sound_time_units_per_second": 200,
    "timing": "convert protocol units at use sites to existing local monotonic deadlines or audio sample timing; inject local time in tests; no separate IGS clocks, foreign tick counters or cycle/interrupt emulation",
    "parser_insertion": "IGS and RIP share the pre-ANSI add-on-parser insertion point in CTerm receive dispatch before base ANSI/VT52 processing; selected parser owns protocol payloads and forwards ordinary bytes through the existing plain-input path; preserve separate grammars and existing encoding/hook/capture/semantic-bypass contracts"
  },
