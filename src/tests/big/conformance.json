{
  "schema_version": 1,
  "target": "Fully enabled BIG1.03 terminal, VGA-capable, supplied IBM VGA console font/palette profile",
  "reference_root": "~/IGS/docs/big/",
  "contract": {
    "scope": "Terminal only; BF, DOS client UI, demo restrictions and CONDOR excluded.",
    "rounding": "Original chapter34 software/default-precision WORD results, including g3 Y5->11. No x87 emulation.",
    "framebuffer": "Existing indexed bitmap and indexed pages/images; format conversion at edges, explicit layout/capacity/padding; no persistent planar shadow.",
    "timing": "Existing local monotonic deadlines/audio samples; no foreign system clocks/BIOS interrupts/throughput delays.",
    "audio": "Functional synthesis/playback/lifecycle; no canonical-PCM or listening gate; manual checklist required.",
    "pointer": "Keyboard/X6 and native mouse coexist; latest movement wins, stationary button samples do not undo keyboard moves. Left release after a valid press confirms. No OS-pointer warp; preserve keyboard confirm/cancel and suppress UI/disabled/outside/reset/duplicate selections.",
    "safe_port": "Preserve normal byte/WORD/state/pixel/reply behavior and document checked/bounded corrections to corruption, uninitialized state and unsafe failures."
  },
