file(READ "${ASSET_DIRECTORY}/manifest.json" manifest)
string(JSON revision GET "${manifest}" revision)
if(NOT revision STREQUAL "2fb17724b6122a5ad5cd1df38b69b8cce3a7079f")
	message(FATAL_ERROR "Review the contract before changing the icon reference pin")
endif()
string(JSON count LENGTH "${manifest}" files)
if(NOT count EQUAL 2)
	message(FATAL_ERROR "Expected the two pinned RADIO reference files")
endif()
foreach(index RANGE 0 1)
	string(JSON name GET "${manifest}" files ${index} file)
	string(JSON expected_size GET "${manifest}" files ${index} size)
	string(JSON expected_hash GET "${manifest}" files ${index} sha256)
	file(SIZE "${ASSET_DIRECTORY}/${name}" actual_size)
	file(SHA256 "${ASSET_DIRECTORY}/${name}" actual_hash)
	if(NOT actual_size EQUAL expected_size OR NOT actual_hash STREQUAL expected_hash)
		message(FATAL_ERROR "Pinned historical fixture changed or is an LFS pointer: ${name}")
	endif()
endforeach()
