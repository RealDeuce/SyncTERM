file(READ "${ASSET_DIRECTORY}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" files)
set(source "/* Generated from hash-verified historical assets. */\n#include \"st_rip3_font_data.h\"\n\n")
set(rows "")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
	string(JSON name GET "${manifest}" files ${index} name)
	string(JSON expected GET "${manifest}" files ${index} sha256)
	string(JSON size GET "${manifest}" files ${index} size)
	file(SHA256 "${ASSET_DIRECTORY}/${name}" actual)
	file(SIZE "${ASSET_DIRECTORY}/${name}" actual_size)
	if(NOT actual STREQUAL expected OR NOT actual_size EQUAL size)
		message(FATAL_ERROR "Pinned RIP3 font asset changed: ${name}")
	endif()
	file(READ "${ASSET_DIRECTORY}/${name}" hex HEX)
	string(APPEND source "static const uint8_t font_${index}[] = {\n")
	string(LENGTH "${hex}" length)
	set(offset 0)
	while(offset LESS length)
		math(EXPR chunk "${length} - ${offset}")
		if(chunk GREATER 128)
			set(chunk 128)
		endif()
		string(SUBSTRING "${hex}" ${offset} ${chunk} line)
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," line "${line}")
		string(APPEND source "\t${line}\n")
		math(EXPR offset "${offset} + ${chunk}")
	endwhile()
	string(APPEND source "};\n")
	string(APPEND rows "\t{\"${name}\", font_${index}, sizeof(font_${index})},\n")
endforeach()
string(APPEND source "\nstatic const struct st_rip3_font_asset assets[] = {\n${rows}};\n\n")
string(APPEND source "size_t\nst_rip3_font_asset_count(void)\n{\n\treturn sizeof(assets) / sizeof(*assets);\n}\n\n")
string(APPEND source "const struct st_rip3_font_asset *\nst_rip3_font_asset_at(size_t index)\n{\n\treturn index < st_rip3_font_asset_count() ? &assets[index] : NULL;\n}\n")
file(WRITE "${OUTPUT}" "${source}")
