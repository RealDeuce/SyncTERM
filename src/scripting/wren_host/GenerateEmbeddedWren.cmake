if(NOT DEFINED OUTPUT)
	message(FATAL_ERROR "OUTPUT is required")
endif()

file(WRITE "${OUTPUT}"
	"/* Generated by GenerateEmbeddedWren.cmake. DO NOT EDIT. */\n"
	"#include \"wren_host_internal.h\"\n\n"
	"const struct st_embedded_script st_wren_embedded_scripts[] = {\n")

math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_index RANGE 0 ${_last})
	if(_index LESS 4)
		continue()
	endif()
	set(_path "${CMAKE_ARGV${_index}}")
	if(NOT _path MATCHES "[.]wren$")
		continue()
	endif()
	get_filename_component(_name "${_path}" NAME_WE)
	set(_event "NULL")
	if(_path MATCHES "[/\\\\]auto[/\\\\]([^/\\\\]+)[/\\\\]")
		set(_event "\"${CMAKE_MATCH_1}\"")
	endif()
	file(READ "${_path}" _hex HEX)
	string(LENGTH "${_hex}" _hex_length)
	set(_lines "")
	set(_offset 0)
	while(_offset LESS _hex_length)
		math(EXPR _remaining "${_hex_length} - ${_offset}")
		if(_remaining GREATER 128)
			set(_length 128)
		else()
			set(_length ${_remaining})
		endif()
		string(SUBSTRING "${_hex}" ${_offset} ${_length} _line)
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" _line
			"${_line}")
		list(APPEND _lines "\t    \"${_line}\"\n")
		math(EXPR _offset "${_offset} + ${_length}")
	endwhile()
	string(JOIN "" _body ${_lines})
	file(APPEND "${OUTPUT}" "\t{ \"${_name}\",\n${_body}\t    , ${_event} },\n")
endforeach()

file(APPEND "${OUTPUT}" "\t{ NULL, NULL, NULL }\n};\n")
