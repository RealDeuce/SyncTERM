# Run at configure time so changes to any notice also regenerate the data.
set(_st_license_output "${CMAKE_CURRENT_BINARY_DIR}/embedded_licenses.c")
set(_st_license_source "/* Generated by GenerateLicenses.cmake. DO NOT EDIT. */\n#include \"wren_licenses.h\"\n\n")
set(_st_license_rows "")
set(_st_license_index 0)

macro(st_embed_license name path)
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
	file(READ "${path}" _st_license_hex HEX)
	string(LENGTH "${_st_license_hex}" _st_license_length)
	string(APPEND _st_license_source
		"static const unsigned char notice_${_st_license_index}[] = {\n")
	set(_st_license_offset 0)
	while(_st_license_offset LESS _st_license_length)
		math(EXPR _st_license_chunk "${_st_license_length} - ${_st_license_offset}")
		if(_st_license_chunk GREATER 128)
			set(_st_license_chunk 128)
		endif()
		string(SUBSTRING "${_st_license_hex}" ${_st_license_offset}
			${_st_license_chunk} _st_license_line)
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1,"
			_st_license_line "${_st_license_line}")
		string(APPEND _st_license_source "\t${_st_license_line}\n")
		math(EXPR _st_license_offset "${_st_license_offset} + ${_st_license_chunk}")
	endwhile()
	string(APPEND _st_license_source "\t0\n};\n\n")
	string(APPEND _st_license_rows
		"\t{\"${name}\", notice_${_st_license_index}, sizeof(notice_${_st_license_index}) - 1},\n")
	math(EXPR _st_license_index "${_st_license_index} + 1")
endmacro()

set(_st_license_root "${CMAKE_CURRENT_LIST_DIR}/..")
st_embed_license("SyncTERM (BSD 2-Clause)" "${_st_license_root}/LICENSE")
st_embed_license("XMODEM / YMODEM (BSD 2-Clause)" "${_st_license_root}/transfer/LICENSE.XMODEM")
st_embed_license("ZMODEM (BSD 2-Clause)" "${_st_license_root}/transfer/LICENSE.ZMODEM")
st_embed_license("Wren (MIT)" "${_st_license_root}/wren_vm/LICENSE")
st_embed_license("libretro API (MIT)" "${_st_license_root}/app/LICENSE.LIBRETRO")
st_embed_license("RE1 (BSD 3-Clause)" "${_st_license_root}/re1/LICENSE")
st_embed_license("RSA MD5" "${_st_license_root}/md5/LICENSE")
st_embed_license("Unicode data (Unicode License v3)"
	"${_st_license_root}/unicode_text/LICENSE.UNICODE")
st_embed_license("UNSCII (Public domain)" "${_st_license_root}/fonts/LICENSE.UNSCII")
st_embed_license("SyncTERM Emoji (SIL OFL 1.1)"
	"${_st_license_root}/fonts/LICENSE.NOTO-EMOJI")
if(SYNCTERM_ENABLE_UNIFONT)
	st_embed_license("SyncTERM Unicode (SIL OFL 1.1)"
		"${_st_license_root}/unifont/LICENSE.OFL-1.1")
endif()
string(APPEND _st_license_source
	"const struct st_wren_license st_wren_licenses[] = {\n${_st_license_rows}\t{NULL, NULL, 0}\n};\n")
file(WRITE "${_st_license_output}.in" "${_st_license_source}")
configure_file("${_st_license_output}.in" "${_st_license_output}" COPYONLY)
