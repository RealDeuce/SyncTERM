cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/dependency_recipes.cmake")
# Use real production recipes/build machinery with two tiny local packages.
file(MAKE_DIRECTORY "${TEST_ROOT}/package" "${TEST_ROOT}/child" "${TEST_ROOT}/consumer")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/../" DESTINATION "${TEST_ROOT}/modules")
file(WRITE "${TEST_ROOT}/child/child.h" "int child_answer(void);\n")
file(WRITE "${TEST_ROOT}/child/child.c" "int child_answer(void) {\n#ifdef FIXTURE_RECONFIGURED\nreturn 17;\n#else\nreturn 16;\n#endif\n}\n")
file(WRITE "${TEST_ROOT}/child/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
project(Child C)
add_library(child child.c)
set_target_properties(child PROPERTIES C_STANDARD 17 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
install(TARGETS child ARCHIVE DESTINATION lib LIBRARY DESTINATION lib RUNTIME DESTINATION bin)
install(FILES child.h DESTINATION include)
]=])
file(WRITE "${TEST_ROOT}/package/fixture.h" "int answer(void);\n")
file(WRITE "${TEST_ROOT}/package/fixture.c" "#include <child.h>\nint answer(void) { return child_answer() + 1; }\n")
file(WRITE "${TEST_ROOT}/package/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
# Resolve C++ in the parent before recording the dependency toolchain. A
# compiler discovered only here could differ on the next parent configure.
if(NOT CMAKE_CXX_COMPILER)
  message(FATAL_ERROR "Dependency C++ compiler was not initialized")
endif()
project(Fixture C CXX)
# Configure must run after the prerequisite's install, not merely its download.
find_path(child_include child.h REQUIRED)
find_library(child_library child REQUIRED)
add_library(fixture fixture.c)
set_target_properties(fixture PROPERTIES C_STANDARD 17 C_STANDARD_REQUIRED YES C_EXTENSIONS NO WINDOWS_EXPORT_ALL_SYMBOLS YES)
target_include_directories(fixture PRIVATE "${child_include}")
target_link_libraries(fixture PRIVATE "${child_library}")
install(TARGETS fixture ARCHIVE DESTINATION lib LIBRARY DESTINATION lib RUNTIME DESTINATION bin)
install(FILES fixture.h DESTINATION include)
]=])
foreach(package fixture child)
	set(directory "${TEST_ROOT}/${package}")
	if(package STREQUAL "fixture")
		set(directory "${TEST_ROOT}/package")
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${TEST_ROOT}/${package}.tar" --format=gnutar --
		CMakeLists.txt ${package}.c ${package}.h WORKING_DIRECTORY "${directory}" COMMAND_ERROR_IS_FATAL ANY)
	file(SHA256 "${TEST_ROOT}/${package}.tar" hash_${package})
	set(url_${package} "${TEST_ROOT}/${package}.tar")
	if(TEST_BASE_URL)
		set(url_${package} "${TEST_BASE_URL}/${package}.tar")
	endif()
endforeach()
file(WRITE "${TEST_ROOT}/modules/dependencies/lock.json"
	"{\"dependencies\":{\"FIXTURE\":{\"version\":\"1\",\"url\":\"${url_fixture}\",\"sha256\":\"${hash_fixture}\"},\"CHILD\":{\"version\":\"1\",\"url\":\"${url_child}\",\"sha256\":\"${hash_child}\"}}}")
file(READ "${TEST_ROOT}/modules/dependencies/Recipes.cmake" recipes)
string(REPLACE "if(name STREQUAL \"BOTAN\")" [=[if(name STREQUAL "FIXTURE")
set(package fixture)
set(header fixture.h)
set(libs fixture)
set(deps CHILD)
set(cxx ON)
elseif(name STREQUAL "CHILD")
set(package child)
set(header child.h)
set(libs child)
elseif(name STREQUAL "BOTAN")]=] recipes "${recipes}")
file(WRITE "${TEST_ROOT}/modules/dependencies/Recipes.cmake" "${recipes}")
file(WRITE "${TEST_ROOT}/consumer/main.c" "#include <fixture.h>\nint main(void) {\n#ifdef FIXTURE_RECONFIGURED\nreturn answer() != 18;\n#else\nreturn answer() != 17;\n#endif\n}\n")
file(WRITE "${TEST_ROOT}/consumer/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
project(Consumer C)
set(SYNCTERM_C_STANDARD 17)
include("${MODULES}/SynctermDependencies.cmake")
set(ST_DEP_FIXTURE_SOURCE BUNDLED CACHE STRING "")
set(ST_DEP_FIXTURE_LINKAGE STATIC CACHE STRING "")
set(ST_DEP_CHILD_SOURCE BUNDLED CACHE STRING "")
set(ST_DEP_CHILD_LINKAGE STATIC CACHE STRING "")
syncterm_dependency(NAME FIXTURE HEADER fixture.h LIBRARIES fixture DEFAULT RUNTIME REQUIRED
  PROBE "int main(void) { return 0; }")
add_executable(consumer main.c)
set_target_properties(consumer PROPERTIES C_STANDARD 17 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(consumer PRIVATE st_dep_fixture)
]=])
function(run label success)
	execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
		OUTPUT_FILE "${TEST_ROOT}/${label}.log" ERROR_FILE "${TEST_ROOT}/${label}.err")
	if((success AND NOT result EQUAL 0) OR (NOT success AND result EQUAL 0))
		message(FATAL_ERROR "Unexpected ${label} result ${result}; see ${TEST_ROOT}/${label}.log/.err")
	endif()
endfunction()
set(common "-DMODULES=${TEST_ROOT}/modules" "-DSYNCTERM_DEPENDENCY_CACHE=${TEST_ROOT}/cache")
include("${CMAKE_CURRENT_LIST_DIR}/dependency_multiconfig.cmake")
run(configure TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/build" ${common}
	-DST_DEP_FIXTURE_ARCHIVE= -DST_DEP_CHILD_ARCHIVE= -DSYNCTERM_DEPENDENCY_DOWNLOADS=ON)
if(PARALLEL_BUILDER)
	run(race-configure TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/build-race" ${common})
	# Both build trees fetch the same initially absent archives concurrently.
	file(REMOVE "${TEST_ROOT}/cache/FIXTURE-1.tar" "${TEST_ROOT}/cache/CHILD-1.tar")
	run(build TRUE "${PYTHON}" "${PARALLEL_BUILDER}" --build-pair "${CMAKE_COMMAND}"
		"${TEST_ROOT}/build" "${TEST_ROOT}/build-race")
else()
	run(build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Debug --parallel 2)
endif()
set(executable "${TEST_ROOT}/build/consumer")
file(STRINGS "${TEST_ROOT}/build/CMakeCache.txt" consumer_configurations REGEX "^CMAKE_CONFIGURATION_TYPES:")
string(REGEX REPLACE "^[^=]*=" "" consumer_configurations "${consumer_configurations}")
string(REPLACE "\\;" ";" consumer_configurations "${consumer_configurations}")
if(consumer_configurations)
	set(executable "${TEST_ROOT}/build/Debug/consumer")
endif()
if(CMAKE_HOST_WIN32)
	string(APPEND executable .exe)
endif()
run(execute TRUE "${executable}")
# A later flag change must not drop prerequisite paths that the dependency's
# first compiler detection recorded as implicit includes.
run(flags-reconfigure TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer"
	-B "${TEST_ROOT}/build" ${common} -DCMAKE_C_FLAGS=-DFIXTURE_RECONFIGURED=1)
run(flags-build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Debug --parallel 2)
run(flags-execute TRUE "${executable}")
run(flags-reset TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer"
	-B "${TEST_ROOT}/build" ${common} -DCMAKE_C_FLAGS=)
run(flags-reset-build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Debug --parallel 2)
run(flags-reset-execute TRUE "${executable}")
if("RelWithDebInfo" IN_LIST consumer_configurations)
	run(other-config-build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build"
		--config RelWithDebInfo --parallel 2)
	set(other_executable "${TEST_ROOT}/build/RelWithDebInfo/consumer")
	if(CMAKE_HOST_WIN32)
		string(APPEND other_executable .exe)
	endif()
	run(other-config-execute TRUE "${other_executable}")
endif()
if(TEST_BASE_URL)
	foreach(package fixture child)
		string(TOUPPER "${package}" name)
		file(SHA256 "${TEST_ROOT}/cache/${name}-1.tar" cached)
		if(NOT cached STREQUAL hash_${package})
			message(FATAL_ERROR "Wrong ${name} cached source archive")
		endif()
	endforeach()
	run(cached-offline TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/cached-offline"
		${common} -DSYNCTERM_DEPENDENCY_DOWNLOADS=OFF)
	run(cached-build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/cached-offline" --config Debug --parallel 2)
endif()
run(local-offline TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/local"
	${common} -DSYNCTERM_DEPENDENCY_DOWNLOADS=OFF "-DST_DEP_FIXTURE_ARCHIVE=${TEST_ROOT}/fixture.tar"
	"-DST_DEP_CHILD_ARCHIVE=${TEST_ROOT}/child.tar")
run(local-build TRUE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/local" --config Debug --parallel 2)
run(offline-missing FALSE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/offline"
	"-DMODULES=${TEST_ROOT}/modules" -DSYNCTERM_DEPENDENCY_DOWNLOADS=OFF)
file(WRITE "${TEST_ROOT}/corrupt.tar" "corrupt archive")
run(corrupt-configure TRUE "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer" -B "${TEST_ROOT}/corrupt"
	${common} "-DST_DEP_FIXTURE_ARCHIVE=${TEST_ROOT}/corrupt.tar" "-DST_DEP_CHILD_ARCHIVE=${TEST_ROOT}/child.tar")
run(corrupt-build FALSE "${CMAKE_COMMAND}" --build "${TEST_ROOT}/corrupt" --config Debug)
file(READ "${TEST_ROOT}/corrupt-build.log" log)
file(READ "${TEST_ROOT}/corrupt-build.err" error)
if(NOT "${log}${error}" MATCHES "SHA256|hash|Hash")
	message(FATAL_ERROR "Corrupt archive did not fail at hash verification")
endif()
