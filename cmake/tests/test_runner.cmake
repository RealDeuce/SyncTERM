cmake_minimum_required(VERSION 3.22)
execute_process(COMMAND "${CMAKE_COMMAND}"
	-S "${CMAKE_CURRENT_LIST_DIR}/test_runner_fixture" -B "${TEST_ROOT}"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
	message(FATAL_ERROR "Runner configure failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}" --config Debug
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
	message(FATAL_ERROR "Runner build failed: ${output}\n${error}")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest NAMES ctest HINTS "${cmake_bin}" REQUIRED)
execute_process(COMMAND "${ctest}" --test-dir "${TEST_ROOT}" -C Debug
	--output-on-failure --output-junit "${TEST_ROOT}/results.xml"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
	message(FATAL_ERROR "Runner cases failed: ${output}\n${error}")
endif()
file(READ "${TEST_ROOT}/results.xml" junit)
if(NOT junit MATCHES "<skipped")
	message(FATAL_ERROR "Runner lost the CTest skip status")
endif()
if(CMAKE_HOST_WIN32)
	set(CMAKE_EXECUTABLE_SUFFIX .exe)
endif()
if(EXISTS "${TEST_ROOT}/tests/Debug/runner${CMAKE_EXECUTABLE_SUFFIX}")
	set(runner "${TEST_ROOT}/tests/Debug/runner${CMAKE_EXECUTABLE_SUFFIX}")
else()
	set(runner "${TEST_ROOT}/tests/runner${CMAKE_EXECUTABLE_SUFFIX}")
endif()
foreach(arguments IN ITEMS "" unknown "first;unexpected" skipped failed)
	execute_process(COMMAND "${runner}" ${arguments} RESULT_VARIABLE result)
	if(arguments STREQUAL skipped)
		set(expected 77)
	elseif(arguments STREQUAL failed)
		set(expected 23)
	else()
		set(expected 2)
	endif()
	if(NOT "${result}" STREQUAL "${expected}")
		message(FATAL_ERROR "Runner status ${result}, expected ${expected}: ${arguments}")
	endif()
endforeach()
