# Cargo verifies crate checksums from the pinned upstream Cargo.lock.
find_program(cargo NAMES cargo REQUIRED)
find_program(rustc NAMES rustc REQUIRED)
set(triple "${ST_DEP_LIBRASHADER_RUST_TARGET}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
	if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
		set(triple aarch64-apple-darwin)
	elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
		set(triple x86_64-apple-darwin)
	endif()
endif()
if(NOT triple AND WIN32)
	if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
		set(arch aarch64)
	elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
		set(arch x86_64)
	else()
		set(arch i686)
	endif()
	if(MSVC)
		set(triple "${arch}-pc-windows-msvc")
	else()
		set(triple "${arch}-pc-windows-gnu")
	endif()
endif()
if(NOT triple)
	if(CMAKE_CROSSCOMPILING)
		message(FATAL_ERROR "Set ST_DEP_LIBRASHADER_RUST_TARGET to the Rust target matching the CMake toolchain")
	endif()
	execute_process(COMMAND "${rustc}" -vV OUTPUT_VARIABLE info COMMAND_ERROR_IS_FATAL ANY)
	string(REGEX MATCH "host: ([^\r\n]+)" match "${info}")
	set(triple "${CMAKE_MATCH_1}")
endif()
string(REPLACE "-" "_" key "${triple}")
string(TOUPPER "${key}" upper)
if(NOT MSVC)
	set(ENV{CARGO_TARGET_${upper}_LINKER} "${CMAKE_CXX_COMPILER}")
endif()
set(ENV{CC_${key}} "${CMAKE_C_COMPILER}")
set(ENV{CXX_${key}} "${CMAKE_CXX_COMPILER}")
set(ENV{CFLAGS_${key}} "${CMAKE_C_FLAGS}")
set(ENV{CXXFLAGS_${key}} "${CMAKE_CXX_FLAGS}")
set(ENV{CARGO_HOME} "${SYNCTERM_DEPENDENCY_CACHE}/cargo")
set(offline)
if(NOT SYNCTERM_DEPENDENCY_DOWNLOADS)
	set(offline --offline)
endif()
set(manifest "${SOURCE}/librashader-capi/Cargo.toml")
if(STEP STREQUAL "configure")
	# Give the library its public name before linking, including the name in
	# Windows import tables. The upstream build script renames artifacts later.
	file(READ "${manifest}" contents)
	if(NOT contents MATCHES "name = \"rashader\"")
		string(REPLACE "[lib]" "[lib]\nname = \"rashader\"" contents "${contents}")
		file(WRITE "${manifest}" "${contents}")
	endif()
elseif(STEP STREQUAL "build")
	syncterm_dependency_parallel(jobs cmake)
	set(cargo_jobs)
	if(jobs MATCHES "([0-9]+)$")
		set(cargo_jobs --jobs "${CMAKE_MATCH_1}")
	endif()
	set(crate_type cdylib)
	if(mode STREQUAL "STATIC")
		set(crate_type staticlib)
	endif()
	set(link_args)
	if(APPLE AND mode STREQUAL "SHARED")
		set(link_args -- -C link-arg=-Wl,-install_name,@rpath/librashader.dylib)
	elseif(NOT WIN32 AND mode STREQUAL "SHARED")
		set(link_args -- -C link-arg=-Wl,-soname,librashader.so)
	endif()
	run("${cargo}" rustc --manifest-path "${manifest}" --locked ${offline} --release
		--target "${triple}" --target-dir "${WORK}/target" ${cargo_jobs} --no-default-features
		--features runtime-opengl --lib --crate-type "${crate_type}" ${link_args})
else()
	set(out "${WORK}/target/${triple}/release")
	file(MAKE_DIRECTORY "${prefix}/lib" "${prefix}/include")
	file(COPY "${SOURCE}/include/librashader.h" DESTINATION "${prefix}/include")
	if(mode STREQUAL "STATIC")
		if(MSVC)
			file(COPY "${out}/rashader.lib" DESTINATION "${prefix}/lib")
		else()
			file(COPY "${out}/librashader.a" DESTINATION "${prefix}/lib")
		endif()
	elseif(WIN32)
		file(COPY "${out}/rashader.dll" DESTINATION "${prefix}/bin")
		if(MSVC)
			file(COPY_FILE "${out}/rashader.dll.lib" "${prefix}/lib/rashader.lib")
		else()
			file(COPY "${out}/librashader.dll.a" DESTINATION "${prefix}/lib")
		endif()
	elseif(APPLE)
		file(COPY "${out}/librashader.dylib" DESTINATION "${prefix}/lib")
	else()
		file(COPY "${out}/librashader.so" DESTINATION "${prefix}/lib")
	endif()
endif()
