cmake_minimum_required(VERSION 3.22)
get_filename_component(cache_directory "${CACHE_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${cache_directory}")
# Configurations and independent build trees may share the same source cache.
# Serialize publication and extraction; consumers never observe partial bytes.
file(LOCK "${CACHE_FILE}.lock" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
	message(FATAL_ERROR "Cannot lock dependency cache ${CACHE_FILE}: ${locked}")
endif()
set(archive "${SOURCE_URL}")
if(SOURCE_URL MATCHES "^[a-z]+://")
	set(archive "${CACHE_FILE}")
	set(valid FALSE)
	if(EXISTS "${archive}")
		file(SHA256 "${archive}" actual)
		if(actual STREQUAL SHA256)
			set(valid TRUE)
		endif()
	endif()
	if(NOT valid)
		if(NOT DOWNLOADS)
			message(FATAL_ERROR "Missing or invalid offline dependency archive ${archive}")
		endif()
		set(partial "${archive}.partial")
		file(DOWNLOAD "${SOURCE_URL}" "${partial}" STATUS status
			TLS_VERIFY ON TIMEOUT 120 INACTIVITY_TIMEOUT 30)
		list(GET status 0 code)
		if(NOT code EQUAL 0)
			file(REMOVE "${partial}")
			message(FATAL_ERROR "Dependency download failed (${status}): ${SOURCE_URL}")
		endif()
		file(SHA256 "${partial}" actual)
		if(NOT actual STREQUAL SHA256)
			file(REMOVE "${partial}")
			message(FATAL_ERROR "Dependency SHA256 mismatch for ${SOURCE_URL}: expected ${SHA256}, got ${actual}")
		endif()
		file(RENAME "${partial}" "${archive}")
	endif()
endif()
if(NOT EXISTS "${archive}")
	message(FATAL_ERROR "Missing dependency source archive ${archive}")
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL SHA256)
	message(FATAL_ERROR "Dependency SHA256 mismatch for ${archive}: expected ${SHA256}, got ${actual}")
endif()
set(extract_directory "${DESTINATION}.extract")
file(REMOVE_RECURSE "${extract_directory}")
file(MAKE_DIRECTORY "${extract_directory}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract_directory}")
file(GLOB contents "${extract_directory}/*")
list(REMOVE_ITEM contents "${extract_directory}/.DS_Store")
list(LENGTH contents count)
set(root "${extract_directory}")
if(count EQUAL 1 AND IS_DIRECTORY "${contents}")
	set(root "${contents}")
endif()
file(REMOVE_RECURSE "${DESTINATION}")
file(RENAME "${root}" "${DESTINATION}")
if(NOT root STREQUAL extract_directory)
	file(REMOVE_RECURSE "${extract_directory}")
endif()
