cmake_minimum_required(VERSION 3.22)
include("${SETTINGS}")
foreach(definition IN LISTS dep_definitions)
	string(APPEND CMAKE_C_FLAGS " ${definition}")
	string(APPEND CMAKE_CXX_FLAGS " ${definition}")
endforeach()
if(ARCH)
	set(prefix "${prefix}/slices/${ARCH}")
	set(CMAKE_OSX_ARCHITECTURES "${ARCH}")
	set(CMAKE_SYSTEM_PROCESSOR "${ARCH}")
	string(APPEND CMAKE_C_FLAGS " -arch ${ARCH}")
	string(APPEND CMAKE_CXX_FLAGS " -arch ${ARCH}")
endif()
if(APPLE AND NOT ARCH)
	list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
	if(architecture_count GREATER 1)
		foreach(slice IN LISTS CMAKE_OSX_ARCHITECTURES)
			execute_process(COMMAND "${CMAKE_COMMAND}" "-DSETTINGS=${SETTINGS}"
				"-DSOURCE=${SOURCE}" "-DWORK=${WORK}/${slice}" "-DARCH=${slice}" "-DSTEP=${STEP}"
				-P "${CMAKE_CURRENT_LIST_FILE}" COMMAND_ERROR_IS_FATAL ANY)
		endforeach()
		if(STEP STREQUAL "install")
			find_program(lipo NAMES lipo REQUIRED)
			list(GET CMAKE_OSX_ARCHITECTURES 0 first)
			file(COPY "${prefix}/slices/${first}/include/" DESTINATION "${prefix}/include")
			file(COPY "${prefix}/slices/${first}/share/" DESTINATION "${prefix}/share")
			foreach(library IN LISTS libraries)
				set(slices)
				set(suffix .a)
				if(NOT mode STREQUAL "STATIC")
					set(suffix .dylib)
				endif()
				foreach(slice IN LISTS CMAKE_OSX_ARCHITECTURES)
					list(APPEND slices "${prefix}/slices/${slice}/syncterm/lib${library}${suffix}")
				endforeach()
				execute_process(COMMAND "${lipo}" -create ${slices} -output "${prefix}/syncterm/lib${library}${suffix}"
					COMMAND_ERROR_IS_FATAL ANY)
			endforeach()
			if(kind STREQUAL "botan")
				set(dispatch "/* Generated per-architecture Botan build configuration. */\n")
				set(branch "#if")
				foreach(slice IN LISTS CMAKE_OSX_ARCHITECTURES)
					if(slice STREQUAL "arm64")
						set(test "defined(__aarch64__)")
					elseif(slice STREQUAL "x86_64")
						set(test "defined(__x86_64__)")
					else()
						message(FATAL_ERROR "Unsupported universal Botan slice ${slice}")
					endif()
					file(COPY_FILE "${prefix}/slices/${slice}/include/botan-3/botan/build.h"
						"${prefix}/include/botan-3/botan/build_${slice}.h" ONLY_IF_DIFFERENT)
					string(APPEND dispatch "${branch} ${test}\n#include \"build_${slice}.h\"\n")
					set(branch "#elif")
				endforeach()
				string(APPEND dispatch "#else\n#error Unsupported Botan architecture\n#endif\n")
				file(WRITE "${prefix}/include/botan-3/botan/build.h" "${dispatch}")
			endif()
		endif()
		return()
	endif()
endif()
file(MAKE_DIRECTORY "${WORK}")
if(NOT kind STREQUAL "cmake")
	# Foreign build systems do not consume CMake's compiler-target/sysroot
	# properties. Preserve the corresponding GNU/Clang driver arguments.
	foreach(language C CXX)
		if(CMAKE_${language}_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
			if(CMAKE_SYSROOT)
				string(APPEND CMAKE_${language}_FLAGS " --sysroot=\"${CMAKE_SYSROOT}\"")
			endif()
			if(CMAKE_${language}_COMPILER_ID MATCHES "Clang" AND CMAKE_${language}_COMPILER_TARGET)
				string(APPEND CMAKE_${language}_FLAGS " --target=${CMAKE_${language}_COMPILER_TARGET}")
			endif()
		endif()
	endforeach()
endif()
if(APPLE)
	if(NOT ARCH AND CMAKE_OSX_ARCHITECTURES)
		list(GET CMAKE_OSX_ARCHITECTURES 0 target_arch)
		string(APPEND CMAKE_C_FLAGS " -arch ${target_arch}")
		string(APPEND CMAKE_CXX_FLAGS " -arch ${target_arch}")
	endif()
	if(CMAKE_OSX_DEPLOYMENT_TARGET)
		string(APPEND CMAKE_C_FLAGS " -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
		string(APPEND CMAKE_CXX_FLAGS " -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
	endif()
	if(CMAKE_OSX_SYSROOT AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
		string(APPEND CMAKE_C_FLAGS " -isysroot \"${CMAKE_OSX_SYSROOT}\"")
		string(APPEND CMAKE_CXX_FLAGS " -isysroot \"${CMAKE_OSX_SYSROOT}\"")
	endif()
endif()
if(MSVC AND kind MATCHES "^(botan|openssl)$" AND NOT DEFINED ENV{SYNCTERM_DEPENDENCY_MSVC_ENV})
	# Visual Studio generators can invoke cl without a developer shell.
	# Upstream Ninja/nmake recipes need that same compiler's SDK environment.
	file(TO_CMAKE_PATH "${CMAKE_C_COMPILER}" compiler_path)
	string(REGEX REPLACE "/Tools/MSVC/.*" "/Auxiliary/Build/vcvarsall.bat" vcvars "${compiler_path}")
	if(NOT EXISTS "${vcvars}")
		message(FATAL_ERROR "Cannot locate vcvarsall.bat for ${CMAKE_C_COMPILER}")
	endif()
	set(vcarch x64)
	if(CMAKE_SIZEOF_VOID_P EQUAL 4)
		set(vcarch x86)
	elseif(compiler_path MATCHES "/arm64/")
		if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
			set(vcarch arm64)
		else()
			set(vcarch x64_arm64)
		endif()
	endif()
	file(WRITE "${WORK}/msvc-build.cmd"
		"@echo off\r\ncall \"${vcvars}\" ${vcarch}\r\nif errorlevel 1 exit /b %errorlevel%\r\nset SYNCTERM_DEPENDENCY_MSVC_ENV=1\r\n\"${CMAKE_COMMAND}\" \"-DSETTINGS=${SETTINGS}\" \"-DSOURCE=${SOURCE}\" \"-DWORK=${WORK}\" \"-DSTEP=${STEP}\" -P \"${CMAKE_CURRENT_LIST_FILE}\"\r\nexit /b %errorlevel%\r\n")
	execute_process(COMMAND cmd.exe /d /c "${WORK}/msvc-build.cmd" COMMAND_ERROR_IS_FATAL ANY)
	return()
endif()
set(shared OFF)
if(NOT mode STREQUAL "STATIC")
	set(shared ON)
endif()
set(prefix_paths "${dep_prefixes}")
set(pkg_paths)
set(extra_cflags)
set(extra_ldflags)
foreach(dep IN LISTS dep_prefixes)
	list(APPEND pkg_paths "${dep}/lib/pkgconfig" "${dep}/share/pkgconfig")
	string(APPEND extra_cflags " -I\"${dep}/include\"")
	string(APPEND extra_ldflags " -L\"${dep}/lib\"")
endforeach()
if(WIN32 AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
	list(JOIN pkg_paths ";" pkg_path)
else()
	list(JOIN pkg_paths ":" pkg_path)
endif()
# This script owns a separate process. Inherit these values directly rather
# than putting Windows' semicolon-separated paths through a CMake argument list.
set(ENV{PKG_CONFIG_PATH} "${pkg_path}")
set(ENV{CC} "${CMAKE_C_COMPILER}")
set(ENV{CXX} "${CMAKE_CXX_COMPILER}")
set(ENV{AR} "${CMAKE_AR}")
set(ENV{RANLIB} "${CMAKE_RANLIB}")
set(ENV{CFLAGS} "${CMAKE_C_FLAGS}${extra_cflags}")
set(ENV{CPPFLAGS} "${extra_cflags}")
set(ENV{CXXFLAGS} "${CMAKE_CXX_FLAGS}${extra_cflags}")
set(ENV{LDFLAGS} "${CMAKE_EXE_LINKER_FLAGS}${extra_ldflags}")
function(run)
	execute_process(COMMAND ${ARGN}
		WORKING_DIRECTORY "${WORK}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
if(kind STREQUAL "headers")
	if(STEP STREQUAL "install")
		file(COPY "${SOURCE}/include/" DESTINATION "${prefix}/include")
	endif()
elseif(kind STREQUAL "cmake")
	if(STEP STREQUAL "configure")
		# Keep the actual compiler flags consistent with its initial detection
		# environment. CMake may otherwise remember prerequisite paths as
		# implicit includes and suppress their target include options later.
		string(APPEND CMAKE_C_FLAGS "${extra_cflags}")
		string(APPEND CMAKE_CXX_FLAGS "${extra_cflags}")
		set(initial "set(CMAKE_INSTALL_PREFIX [==[${prefix}]==] CACHE PATH \"\" FORCE)\nset(CMAKE_INSTALL_LIBDIR lib CACHE STRING \"\" FORCE)\nset(CMAKE_BUILD_TYPE [==[${config}]==] CACHE STRING \"\" FORCE)\nset(BUILD_SHARED_LIBS ${shared} CACHE BOOL \"\" FORCE)\nset(BUILD_TESTING OFF CACHE BOOL \"\" FORCE)\nset(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL \"\" FORCE)\nset(CMAKE_PREFIX_PATH [==[${prefix_paths}]==] CACHE STRING \"\" FORCE)\n")
		if(CMAKE_CROSSCOMPILING)
			string(APPEND initial "set(CMAKE_FIND_ROOT_PATH [==[${prefix_paths};${CMAKE_FIND_ROOT_PATH}]==] CACHE STRING \"\" FORCE)\n")
		endif()
		foreach(key CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_AR CMAKE_RANLIB CMAKE_C_FLAGS
			CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SYSROOT CMAKE_TOOLCHAIN_FILE
			CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
			CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET
			CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ${CMAKE_TRY_COMPILE_PLATFORM_VARIABLES})
			if(key MATCHES "^CMAKE_(C|CXX|EXE_LINKER)_FLAGS$" OR NOT "${${key}}" STREQUAL "")
				string(APPEND initial "set(${key} [==[${${key}}]==] CACHE STRING \"\" FORCE)\n")
			endif()
		endforeach()
		file(WRITE "${WORK}/initial.cmake" "${initial}")
		set(args -C "${WORK}/initial.cmake" -G "${CMAKE_GENERATOR}")
		if(CMAKE_GENERATOR_PLATFORM)
			list(APPEND args -A "${CMAKE_GENERATOR_PLATFORM}")
		endif()
		if(CMAKE_GENERATOR_TOOLSET)
			list(APPEND args -T "${CMAKE_GENERATOR_TOOLSET}")
		endif()
		if(name STREQUAL "SDL2")
			list(APPEND args "-DSDL_SHARED=${shared}")
			if(shared)
				list(APPEND args -DSDL_STATIC=OFF)
			else()
				list(APPEND args -DSDL_STATIC=ON)
			endif()
		endif()
		set(cmake_source "${SOURCE}")
		if(name STREQUAL "ADLMIDI")
			if(shared)
				list(APPEND args -DlibADLMIDI_STATIC=OFF -DlibADLMIDI_SHARED=ON)
			else()
				list(APPEND args -DlibADLMIDI_STATIC=ON -DlibADLMIDI_SHARED=OFF)
			endif()
			list(APPEND args -DWITH_MIDI_SEQUENCER=OFF -DWITH_XMI_SUPPORT=OFF)
		endif()
		if(name STREQUAL "MPG123")
			set(cmake_source "${SOURCE}/ports/cmake")
		elseif(name STREQUAL "LAME")
			set(cmake_source "${CMAKE_CURRENT_LIST_DIR}/lame")
			list(APPEND args "-DLAME_SOURCE=${SOURCE}")
		elseif(name STREQUAL "LCMS2")
			list(APPEND args "-DLCMS2_BUILD_SHARED=${shared}")
			if(shared)
				list(APPEND args -DLCMS2_BUILD_STATIC=OFF)
			else()
				list(APPEND args -DLCMS2_BUILD_STATIC=ON)
			endif()
		endif()
		run("${CMAKE_COMMAND}" -S "${cmake_source}" -B "${WORK}" ${args} ${options})
	elseif(STEP STREQUAL "build")
		set(target)
		if(name STREQUAL "FLUIDSYNTH")
			set(target --target libfluidsynth)
		endif()
		run("${CMAKE_COMMAND}" --build "${WORK}" --config "${config}" --parallel 2 ${target})
	else()
		if(name STREQUAL "FLUIDSYNTH")
			foreach(component fluidsynth_runtime fluidsynth_development)
				run("${CMAKE_COMMAND}" --install "${WORK}" --config "${config}" --component "${component}")
			endforeach()
		else()
			run("${CMAKE_COMMAND}" --install "${WORK}" --config "${config}")
		endif()
	endif()
elseif(kind STREQUAL "botan")
	find_program(python NAMES python3 python REQUIRED)
	get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
	set(ninja_hints "${cmake_bin}" "${cmake_bin}/../../Ninja")
	if(MSVC)
		file(TO_CMAKE_PATH "${CMAKE_C_COMPILER}" compiler_path)
		string(REGEX REPLACE "/VC/Tools/MSVC/.*" "" vs_root "${compiler_path}")
		list(APPEND ninja_hints "${vs_root}/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja")
	endif()
	find_program(ninja NAMES ninja ninja-build HINTS ${ninja_hints})
	if(ninja)
		set(build_tool ninja)
		set(build_command "${ninja}")
	elseif(MSVC)
		message(FATAL_ERROR "Botan with MSVC requires Ninja; install it or use Visual Studio's bundled Ninja")
	else()
		find_program(make NAMES gmake make mingw32-make REQUIRED)
		set(build_tool make)
		set(build_command "${make}")
	endif()
	if(STEP STREQUAL "configure")
		set(modules tls12,tls13,aes,cbc,cfb,ctr,chacha,chacha20poly1305,rc4,des,cast128,hmac,pbkdf2,scrypt,pbes2,md5,sha1,sha2_32,sha2_64,rsa,emsa_pssr,ed25519,x25519,dh,ecdsa,ecdh,ml_kem,pcurves_secp256r1,pcurves_secp384r1,pcurves_secp521r1,x509,certstor_system,ffi,system_rng,auto_rng)
		if(APPLE)
			string(APPEND modules ,certstor_system_macos)
		elseif(WIN32)
			string(APPEND modules ,certstor_system_windows)
		else()
			string(APPEND modules ,certstor_flatfile)
		endif()
		set(args "--prefix=${prefix}" "--with-build-dir=${WORK}" "--build-tool=${build_tool}"
			--without-documentation --minimized-build "--enable-modules=${modules}"
			"--cc-bin=${CMAKE_CXX_COMPILER}" "--ar-command=${CMAKE_AR}")
		if(shared)
			list(APPEND args --build-targets=shared)
		else()
			list(APPEND args --build-targets=static --disable-shared-library)
		endif()
		if(MSVC)
			list(APPEND args --cc=msvc)
		elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
			list(APPEND args --cc=clang)
		else()
			list(APPEND args --cc=gcc)
		endif()
		if(WIN32)
			if(MSVC)
				list(APPEND args --os=windows)
			else()
				list(APPEND args --os=mingw)
			endif()
			list(APPEND args --system-cert-bundle=)
		else()
			string(TOLOWER "${CMAKE_SYSTEM_NAME}" botan_os)
			if(botan_os STREQUAL "sunos")
				set(botan_os solaris)
			elseif(botan_os STREQUAL "gnu")
				set(botan_os hurd)
			endif()
			list(APPEND args "--os=${botan_os}")
		endif()
		set(cpu "${CMAKE_SYSTEM_PROCESSOR}")
		if(WIN32 AND CMAKE_C_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM64|ARM64EC)$")
			set(cpu aarch64)
		endif()
		if(ARCH)
			set(cpu "${ARCH}")
		elseif(APPLE AND CMAKE_OSX_ARCHITECTURES)
			list(GET CMAKE_OSX_ARCHITECTURES 0 cpu)
		endif()
		if(cpu MATCHES "^(aarch64|arm64)$")
			set(cpu aarch64)
		elseif(cpu MATCHES "^(AMD64|amd64|x86_64|x86|i[3-6]86)$")
			if(CMAKE_SIZEOF_VOID_P EQUAL 8)
				set(cpu x86_64)
			else()
				set(cpu x86)
			endif()
		endif()
		list(APPEND args "--cpu=${cpu}")
		if(NOT cpu)
			message(FATAL_ERROR "The Botan target architecture is unknown; set CMAKE_SYSTEM_PROCESSOR in the target toolchain")
		endif()
		if(APPLE)
			set(abi "-arch ${cpu}")
			if(cpu STREQUAL "aarch64")
				set(abi "-arch arm64")
			endif()
			if(CMAKE_OSX_DEPLOYMENT_TARGET)
				string(APPEND abi " -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
			endif()
			if(CMAKE_OSX_SYSROOT AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
				string(APPEND abi " -isysroot ${CMAKE_OSX_SYSROOT}")
			endif()
			list(APPEND args "--cc-abi-flags=${abi}")
		endif()
		if(MSVC)
			set(runtime MD)
			if(CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "^MultiThreaded(Debug)?$")
				set(runtime MT)
			endif()
			if(config STREQUAL "Debug")
				string(APPEND runtime d)
			endif()
			list(APPEND args "--msvc-runtime=${runtime}")
		endif()
		if(config STREQUAL "Debug")
			list(APPEND args --debug-mode)
		endif()
		if(CMAKE_CXX_FLAGS)
			list(APPEND args "--extra-cxxflags=${CMAKE_CXX_FLAGS}")
		endif()
		run("${python}" "${SOURCE}/configure.py" ${args})
	elseif(STEP STREQUAL "build")
		run("${build_command}" -C "${WORK}" -j2)
	else()
		run("${build_command}" -C "${WORK}" install)
	endif()
elseif(kind STREQUAL "autotools")
	find_program(make NAMES gmake make REQUIRED)
	if(STEP STREQUAL "configure")
		set(args "--prefix=${prefix}" "--libdir=${prefix}/lib")
		if(shared)
			list(APPEND args --enable-shared --disable-static)
		else()
			list(APPEND args --disable-shared --enable-static)
		endif()
		if(APPLE AND CMAKE_OSX_ARCHITECTURES)
			list(GET CMAKE_OSX_ARCHITECTURES 0 host_arch)
			list(APPEND args "--host=${host_arch}-apple-darwin")
