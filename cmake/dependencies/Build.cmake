elseif(kind STREQUAL "meson")
	find_program(meson NAMES meson REQUIRED)
	if(STEP STREQUAL "configure")
		set(type static)
		if(shared)
			set(type shared)
		endif()
		set(args setup "${WORK}" "${SOURCE}" "--prefix=${prefix}" --libdir=lib "--default-library=${type}")
		# Meson caches environment flags at its first setup. Pass them as
		# explicit options so configuration changes also update an existing tree.
		foreach(language c cpp)
			set(flags "${CMAKE_C_FLAGS}${extra_cflags}")
			if(language STREQUAL "cpp")
				set(flags "${CMAKE_CXX_FLAGS}${extra_cflags}")
			endif()
			separate_arguments(items NATIVE_COMMAND "${flags}")
			set(quoted)
			foreach(item IN LISTS items)
				string(REPLACE "\\" "\\\\" item "${item}")
				string(REPLACE "'" "\\'" item "${item}")
				list(APPEND quoted "'${item}'")
			endforeach()
			list(JOIN quoted "," value)
			list(APPEND args "-D${language}_args=[${value}]")
			separate_arguments(items NATIVE_COMMAND "${CMAKE_EXE_LINKER_FLAGS}${extra_ldflags}")
			set(quoted)
			foreach(item IN LISTS items)
				string(REPLACE "\\" "\\\\" item "${item}")
				string(REPLACE "'" "\\'" item "${item}")
				list(APPEND quoted "'${item}'")
			endforeach()
			list(JOIN quoted "," value)
			list(APPEND args "-D${language}_link_args=[${value}]")
		endforeach()
		string(SHA256 toolchain "${CMAKE_C_COMPILER};${CMAKE_CXX_COMPILER};${CMAKE_AR};${CMAKE_SYSROOT};${CMAKE_SYSTEM_NAME};${CMAKE_SYSTEM_PROCESSOR};${CMAKE_OSX_ARCHITECTURES};${CMAKE_CROSSCOMPILING}")
		set(previous_toolchain "")
		if(EXISTS "${WORK}/syncterm-toolchain.txt")
			file(READ "${WORK}/syncterm-toolchain.txt" previous_toolchain)
		endif()
		if(EXISTS "${WORK}/meson-private/coredata.dat")
			if(previous_toolchain STREQUAL toolchain)
				list(APPEND args --reconfigure)
			else()
				list(APPEND args --wipe)
			endif()
		endif()
		if(CMAKE_CROSSCOMPILING OR (APPLE AND CMAKE_OSX_ARCHITECTURES))
			set(system "${CMAKE_SYSTEM_NAME}")
			string(TOLOWER "${system}" system)
			set(cpu "${CMAKE_SYSTEM_PROCESSOR}")
			if(APPLE AND CMAKE_OSX_ARCHITECTURES)
				list(GET CMAKE_OSX_ARCHITECTURES 0 cpu)
			endif()
			string(TOLOWER "${cpu}" family)
			if(family MATCHES "^(amd64|x86_64)$")
				if(CMAKE_SIZEOF_VOID_P EQUAL 8)
					set(family x86_64)
				else()
					set(family x86)
				endif()
			elseif(family MATCHES "^(i[3-6]86|x86)$")
				set(family x86)
			elseif(family MATCHES "^(arm64|aarch64)$")
				set(family aarch64)
			elseif(family MATCHES "^arm")
				set(family arm)
			endif()
			set(endian little)
			if(CMAKE_C_BYTE_ORDER STREQUAL "BIG_ENDIAN")
				set(endian big)
			endif()
			set(cross "[binaries]\nc = '${CMAKE_C_COMPILER}'\ncpp = '${CMAKE_CXX_COMPILER}'\nar = '${CMAKE_AR}'\nstrip = '${CMAKE_STRIP}'\n[host_machine]\nsystem = '${system}'\ncpu_family = '${family}'\ncpu = '${cpu}'\nendian = '${endian}'\n[properties]\nneeds_exe_wrapper = true\n")
			file(WRITE "${WORK}/cross.ini" "${cross}")
			list(APPEND args --cross-file "${WORK}/cross.ini")
		endif()
		run("${meson}" ${args} ${options})
		file(WRITE "${WORK}/syncterm-toolchain.txt" "${toolchain}")
	elseif(STEP STREQUAL "build")
		run("${meson}" compile -C "${WORK}" -j2)
	else()
		run("${meson}" install -C "${WORK}")
	endif()
elseif(kind STREQUAL "openssl")
	find_program(perl NAMES perl REQUIRED)
	if(MSVC)
		find_program(make NAMES nmake REQUIRED)
	else()
		find_program(make NAMES gmake make REQUIRED)
	endif()
	if(STEP STREQUAL "configure")
		set(args "--prefix=${prefix}" --libdir=lib no-tests no-module)
		if(config STREQUAL "Debug")
			list(APPEND args --debug)
		endif()
		if(shared)
			list(APPEND args shared)
		else()
			list(APPEND args no-shared)
		endif()
		if(APPLE)
			set(openssl_arch "${CMAKE_SYSTEM_PROCESSOR}")
			if(CMAKE_OSX_ARCHITECTURES)
				list(GET CMAKE_OSX_ARCHITECTURES 0 openssl_arch)
			endif()
			if(openssl_arch MATCHES "^(arm64|aarch64)$")
				list(PREPEND args darwin64-arm64-cc)
			elseif(openssl_arch MATCHES "^(x86_64|amd64)$")
				list(PREPEND args darwin64-x86_64-cc)
			else()
				message(FATAL_ERROR "Unsupported OpenSSL macOS architecture ${openssl_arch}")
			endif()
		elseif(WIN32)
			if(MSVC)
				if(CMAKE_C_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM64|ARM64EC)$")
					set(openssl_target VC-WIN64-ARM)
				elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
					set(openssl_target VC-WIN64A)
				else()
					set(openssl_target VC-WIN32)
				endif()
				# OpenSSL otherwise chooses its CRT from shared/static linkage.
				# Its supported custom-target hook keeps the parent's CRT policy
				# independent of linkage, including Debug's runtime variant.
				set(runtime MD)
				if(CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "^MultiThreaded(Debug)?$")
					set(runtime MT)
				endif()
				if(config STREQUAL "Debug")
					string(APPEND runtime d)
				endif()
				file(WRITE "${WORK}/syncterm-msvc.conf"
					"my %targets = (\n  'syncterm-msvc' => {\n    inherit_from => ['${openssl_target}'],\n    cflags => '/GF /Gy',\n    lib_cflags => '/Zi /Fdossl_static.pdb /${runtime}',\n    bin_cflags => '/Zi /Fdapp.pdb /${runtime}',\n  },\n);\n")
				list(PREPEND args syncterm-msvc "--config=${WORK}/syncterm-msvc.conf")
				if(NOT CMAKE_C_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM64|ARM64EC)$")
					find_program(nasm NAMES nasm)
					if(NOT nasm)
						list(APPEND args no-asm)
					endif()
				endif()
			elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
				list(PREPEND args mingw64)
			else()
				list(PREPEND args mingw)
			endif()
		endif()
		run("${perl}" "${SOURCE}/Configure" ${args})
	elseif(STEP STREQUAL "build")
		run("${make}")
	else()
		run("${make}" install_sw)
	endif()
else()
	message(FATAL_ERROR "Unknown dependency build system ${kind}")
endif()

if(STEP STREQUAL "install")
	file(GLOB_RECURSE notices RELATIVE "${SOURCE}"
		"${SOURCE}/LICENSE*" "${SOURCE}/COPYING*" "${SOURCE}/NOTICE*")
	if(name STREQUAL "ADLMIDI")
		list(APPEND notices README.md fm_banks_new/greyzone/README.txt)
	endif()
	foreach(notice IN LISTS notices)
		get_filename_component(directory "${notice}" DIRECTORY)
		file(MAKE_DIRECTORY "${prefix}/share/licenses/${name}/${directory}")
		file(COPY "${SOURCE}/${notice}" DESTINATION
			"${prefix}/share/licenses/${name}/${directory}")
	endforeach()
	# Normalize upstream archive filenames, including MSVC's varying .lib names.
	set(static_suffix .a)
	if(MSVC)
		set(static_suffix .lib)
	endif()
	foreach(library IN LISTS libraries)
		unset(found)
		if(mode STREQUAL "STATIC")
			set(CMAKE_FIND_LIBRARY_SUFFIXES .a .lib)
			set(destination "${prefix}/syncterm/lib${library}${static_suffix}")
		else()
			set(CMAKE_FIND_LIBRARY_SUFFIXES .so .dylib .dll.a .lib)
			if(APPLE)
				set(suffix .dylib)
			elseif(WIN32)
				set(suffix .dll)
			else()
				set(suffix .so)
			endif()
			set(destination "${prefix}/syncterm/lib${library}${suffix}")
		endif()
		set(CMAKE_FIND_LIBRARY_PREFIXES lib "")
		find_library(found NAMES ${library} ${library}-static ${library}_static lib${library}
			PATHS "${prefix}/lib" "${prefix}/lib64" "${prefix}/lib/pulseaudio" NO_DEFAULT_PATH NO_CACHE)
		if(NOT found)
			file(GLOB candidates "${prefix}/lib/*${library}*.a" "${prefix}/lib/*${library}*.lib")
			list(LENGTH candidates count)
			if(count EQUAL 1)
				list(GET candidates 0 found)
			else()
				message(FATAL_ERROR "${name} did not install required ${mode} library ${library}: ${candidates}")
			endif()
		endif()
		if(WIN32 AND NOT mode STREQUAL "STATIC")
			file(COPY_FILE "${found}" "${destination}${static_suffix}" ONLY_IF_DIFFERENT)
			# An import library is not a DLL. Preserve the upstream DLL filename
			# as well, since it is recorded in consumers' import tables.
			file(GLOB dlls "${prefix}/bin/${library}.dll" "${prefix}/bin/lib${library}.dll"
				"${prefix}/bin/${library}-[0-9]*.dll" "${prefix}/bin/lib${library}-[0-9]*.dll"
				"${prefix}/lib/${library}.dll" "${prefix}/lib/lib${library}.dll")
			list(LENGTH dlls dll_count)
			if(NOT dll_count EQUAL 1)
				message(FATAL_ERROR "Cannot identify ${library} DLL beside ${found}: ${dlls}")
			endif()
			list(GET dlls 0 dll)
			file(COPY "${dll}" DESTINATION "${prefix}/syncterm")
			file(COPY_FILE "${dll}" "${destination}" ONLY_IF_DIFFERENT)
		else()
			file(COPY_FILE "${found}" "${destination}" ONLY_IF_DIFFERENT)
		endif()
	endforeach()
	if(NOT mode STREQUAL "STATIC" AND NOT WIN32)
		# Retain SONAME filenames beside the normalized link name.
		file(GLOB shared_libraries "${prefix}/lib/*.so*" "${prefix}/lib/*.dylib"
			"${prefix}/lib64/*.so*" "${prefix}/lib/pulseaudio/*.so*")
		if(shared_libraries)
			file(COPY ${shared_libraries} DESTINATION "${prefix}/syncterm" FOLLOW_SYMLINK_CHAIN)
		endif()
	endif()
endif()
