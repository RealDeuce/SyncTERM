include_guard(GLOBAL)

# Only the client libraries and APIs used by SyncTERM are enabled.
function(syncterm_dependency_recipe name)
	set(kind cmake)
	# Some C libraries still enable C++ in their upstream CMake project.
	set(cxx OFF)
	if(name MATCHES "^(BOTAN|SNDFILE|FLAC|JXL|HIGHWAY|FLUIDSYNTH|ADLMIDI|GCEM)$")
		set(cxx ON)
	endif()
	set(deps)
	set(options)
	set(include_suffix "")
	if(name STREQUAL "BOTAN")
		set(kind botan)
		set(package botan-3)
		set(header botan/version.h)
		set(libs botan-3)
		set(include_suffix botan-3)
	elseif(name STREQUAL "OPENSSL")
		set(kind openssl)
		set(package openssl)
		set(header openssl/ssl.h)
		set(libs ssl crypto)
	elseif(name STREQUAL "SNDFILE")
		set(package sndfile)
		set(header sndfile.h)
		set(libs sndfile)
		set(deps FLAC OGG VORBIS OPUS MPG123 LAME)
		set(options -DBUILD_PROGRAMS=OFF -DBUILD_EXAMPLES=OFF -DENABLE_EXTERNAL_LIBS=ON -DENABLE_MPEG=ON)
	elseif(name STREQUAL "FLAC")
		set(package flac)
		set(header FLAC/stream_decoder.h)
		set(libs FLAC)
		set(deps OGG)
		set(options -DBUILD_CXXLIBS=OFF -DBUILD_PROGRAMS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_DOCS=OFF)
	elseif(name STREQUAL "OGG")
		set(package ogg)
		set(header ogg/ogg.h)
		set(libs ogg)
	elseif(name STREQUAL "VORBIS")
		set(package vorbisenc)
		set(header vorbis/vorbisenc.h)
		set(libs vorbisenc vorbis)
		set(deps OGG)
	elseif(name STREQUAL "OPUS")
		set(package opus)
		set(header opus/opus.h)
		set(libs opus)
		set(options -DOPUS_BUILD_PROGRAMS=OFF -DOPUS_BUILD_TESTING=OFF)
	elseif(name STREQUAL "MPG123")
		set(package libmpg123)
		set(header mpg123.h)
		set(libs mpg123)
		set(options -DBUILD_LIBOUT123=OFF -DNETWORK=OFF)
	elseif(name STREQUAL "LAME")
		set(package lame)
		set(header lame/lame.h)
		set(libs mp3lame)
	elseif(name STREQUAL "JXL")
		set(package libjxl)
		set(header jxl/decode.h)
		set(libs jxl jxl_cms jxl_threads)
		set(deps BROTLI HIGHWAY LCMS2)
		set(options -DJPEGXL_ENABLE_TOOLS=OFF -DJPEGXL_ENABLE_DEVTOOLS=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF
			-DJPEGXL_ENABLE_BENCHMARK=OFF -DJPEGXL_ENABLE_MANPAGES=OFF -DJPEGXL_ENABLE_DOXYGEN=OFF
			-DJPEGXL_ENABLE_JPEGLI=OFF -DJPEGXL_ENABLE_SKCMS=OFF -DJPEGXL_FORCE_SYSTEM_BROTLI=ON
			-DJPEGXL_FORCE_SYSTEM_HWY=ON -DJPEGXL_BUNDLE_LIBPNG=OFF -DJPEGXL_ENABLE_SJPEG=OFF
			-DJPEGXL_ENABLE_EXTRAS=OFF)
	elseif(name STREQUAL "BROTLI")
		set(package libbrotlidec)
		set(header brotli/decode.h)
		set(libs brotlidec brotlienc brotlicommon)
		set(options -DBROTLI_DISABLE_TESTS=ON)
	elseif(name STREQUAL "HIGHWAY")
		set(package "libhwy>=1.0.7")
		set(header hwy/highway.h)
		set(libs hwy)
		set(options -DHWY_ENABLE_TESTS=OFF -DHWY_ENABLE_EXAMPLES=OFF -DHWY_ENABLE_CONTRIB=OFF)
	elseif(name STREQUAL "LCMS2")
		set(package "lcms2>=2.12")
		set(header lcms2.h)
		set(libs lcms2)
		set(options -DLCMS2_BUILD_TOOLS=OFF -DLCMS2_BUILD_TESTS=OFF)
	elseif(name STREQUAL "SDL2")
		set(package sdl2)
		set(header SDL.h)
		set(libs SDL2)
		set(include_suffix SDL2)
		set(options -DSDL_TEST=OFF -DSDL_TESTS=OFF)
	elseif(name STREQUAL "PORTAUDIO")
		set(package portaudio-2.0)
		set(header portaudio.h)
		set(libs portaudio)
		set(options -DPA_BUILD_EXAMPLES=OFF -DPA_BUILD_TESTS=OFF -DPA_USE_JACK=OFF)
		if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
			set(deps ALSA)
			list(APPEND options -DPA_USE_ALSA=ON)
		endif()
	elseif(name STREQUAL "FLUIDSYNTH")
		set(package fluidsynth)
		set(header fluidsynth.h)
		set(libs fluidsynth)
		set(deps SNDFILE GCEM)
		set(options -Denable-alsa=OFF -Denable-aufile=OFF -Denable-coreaudio=OFF -Denable-coremidi=OFF
			-Denable-dart=OFF -Denable-dbus=OFF -Denable-framework=OFF -Denable-ipv6=OFF
			-Denable-jack=OFF -Denable-ladspa=OFF -Denable-libinstpatch=OFF -Denable-midishare=OFF
			-Denable-network=OFF -Denable-oboe=OFF -Denable-opensles=OFF -Denable-oss=OFF
			-Denable-pipewire=OFF -Denable-portaudio=OFF -Denable-pulseaudio=OFF -Denable-readline=OFF
			-Denable-sdl3=OFF -Denable-threads=ON -Denable-wasapi=OFF -Denable-waveout=OFF
			-Denable-dsound=OFF -Denable-oss=OFF -Denable-native-dls=OFF -Denable-signalsmith=OFF
			-Denable-systemd=OFF -Denable-openmp=OFF
			-Denable-winmidi=OFF -Denable-libsndfile=ON -Denable-floats=ON -Denable-sf3=ON)
	elseif(name STREQUAL "GCEM")
		set(kind headers)
		set(package gcem)
		set(header gcem.hpp)
		set(libs)
	elseif(name STREQUAL "ADLMIDI")
		set(package libADLMIDI)
		set(header adlmidi.h)
		set(libs ADLMIDI)
		set(options -DWITH_MIDIPLAY=OFF -DWITH_MIDI2WAV=OFF -DWITH_ADLMIDI2=OFF -DWITH_VLC_PLUGIN=OFF)
	elseif(name STREQUAL "ALSA")
		set(kind autotools)
		set(package alsa)
		set(header alsa/asoundlib.h)
		set(libs asound)
	elseif(name STREQUAL "PULSEAUDIO")
		set(kind meson)
		set(package libpulse-simple)
		set(header pulse/simple.h)
		set(libs pulse-simple pulse)
		if(mode STREQUAL "STATIC")
			list(APPEND libs pulsecommon-17.0)
		endif()
		set(deps SNDFILE)
		set(options -Ddaemon=false -Dtests=false -Dman=false -Ddoxygen=false -Dclient=true
			-Ddatabase=simple -Dgtk=disabled -Dglib=disabled -Dgsettings=disabled
			-Ddbus=disabled -Dopenssl=disabled -Dorc=disabled -Dsoxr=disabled -Dspeex=disabled
			-Dx11=disabled -Dsystemd=disabled -Dasyncns=disabled -Davahi=disabled
			-Dbluez5=disabled -Dalsa=disabled -Djack=disabled -Dudev=disabled
			-Dsamplerate=disabled -Dfftw=disabled -Dwebrtc-aec=disabled)
	elseif(name STREQUAL "PIPEWIRE")
		set(kind meson)
		set(package libpipewire-0.3)
		set(header pipewire/pipewire.h)
		set(include_suffix pipewire-0.3)
		set(libs pipewire-0.3)
		set(options -Dpipewire-alsa=disabled -Dpipewire-jack=disabled -Dpipewire-v4l2=disabled
			-Dsession-managers=[] -Dtests=disabled -Dexamples=disabled -Dman=disabled
			-Ddocs=disabled -Dinstalled_tests=disabled -Dgstreamer=disabled -Dlibsystemd=disabled
			-Dauto_features=disabled -Dspa-plugins=enabled -Dsupport=enabled -Daudioconvert=enabled
			-Ddbus=disabled -Dudev=disabled -Dlibpulse=disabled
			-Dsndfile=disabled -Dreadline=disabled -Dbluez5=disabled -Dlibcamera=disabled)
	elseif(name STREQUAL "WAYLAND")
		set(kind meson)
		set(package wayland-client)
		set(header wayland-client.h)
		set(libs wayland-client)
		set(deps FFI EXPAT)
		set(options -Ddocumentation=false -Dtests=false -Ddtd_validation=false)
	elseif(name STREQUAL "XKBCOMMON")
		set(kind meson)
		set(package xkbcommon)
		set(header xkbcommon/xkbcommon.h)
		set(libs xkbcommon)
		set(options -Denable-x11=false -Denable-wayland=false -Denable-docs=false -Denable-tools=false -Denable-xkbregistry=false)
	elseif(name STREQUAL "NCURSES" OR name STREQUAL "TERMINFO" OR name STREQUAL "CURSES")
		set(kind autotools)
		set(package ncursesw)
		set(header curses.h)
		set(libs ncursesw)
		set(include_suffix ncursesw)
		set(options --enable-widec --without-progs --without-tests --without-manpages --without-cxx)
	elseif(name MATCHES "^(X11|XINERAMA|XRANDR|XRENDER|XEXT|XFIXES|XAU|XDMCP|XCB|XORGPROTO|XTRANS|PTHREAD_STUBS)$")
		set(kind autotools)
		if(name STREQUAL "X11")
			set(package x11)
			set(header X11/Xlib.h)
			set(libs X11)
			set(deps XCB XORGPROTO XTRANS)
			set(options --disable-specs --without-xmlto --without-fop)
		elseif(name STREQUAL "XCB")
			set(package xcb)
			set(header xcb/xcb.h)
			set(libs xcb)
			set(deps XAU XDMCP PTHREAD_STUBS)
		elseif(name STREQUAL "XORGPROTO")
			set(package xproto)
			set(header X11/X.h)
			set(libs)
		elseif(name STREQUAL "XTRANS")
			set(package xtrans)
			set(header X11/Xtrans/Xtrans.h)
			set(libs)
		elseif(name STREQUAL "PTHREAD_STUBS")
			set(package pthread-stubs)
			set(header pthread.h)
			set(libs)
		else()
			string(TOLOWER "${name}" package)
			if(name STREQUAL "XINERAMA")
				set(libs Xinerama)
				set(header X11/extensions/Xinerama.h)
				set(deps X11 XEXT XORGPROTO)
			elseif(name STREQUAL "XRANDR")
				set(libs Xrandr)
				set(header X11/extensions/Xrandr.h)
				set(deps X11 XEXT XRENDER XORGPROTO)
			elseif(name STREQUAL "XRENDER")
				set(libs Xrender)
				set(header X11/extensions/Xrender.h)
				set(deps X11 XORGPROTO)
			elseif(name STREQUAL "XEXT")
				set(libs Xext)
				set(header X11/extensions/Xext.h)
				set(deps X11 XORGPROTO)
			elseif(name STREQUAL "XFIXES")
				set(libs Xfixes)
				set(header X11/extensions/Xfixes.h)
				set(deps X11 XORGPROTO)
			elseif(name STREQUAL "XAU")
				set(libs Xau)
				set(header X11/Xauth.h)
				set(deps XORGPROTO)
			else()
				set(libs Xdmcp)
				set(header X11/Xdmcp.h)
				set(deps XORGPROTO)
			endif()
		endif()
	elseif(name STREQUAL "FFI")
		set(kind autotools)
		set(package libffi)
		set(header ffi.h)
		set(libs ffi)
	elseif(name STREQUAL "EXPAT")
		set(package expat)
		set(header expat.h)
		set(libs expat)
		set(options -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_EXAMPLES=OFF -DEXPAT_BUILD_TESTS=OFF)
	else()
		message(FATAL_ERROR "No pinned dependency recipe for ${name}")
	endif()
	foreach(field kind cxx package header libs deps options include_suffix)
		set(recipe_${field} "${${field}}" PARENT_SCOPE)
	endforeach()
endfunction()
