# Parent-owned provider injection for the pinned DeuceSSH revision. Only the
# downloaded build-tree source is patched; the upstream repository is untouched.
file(READ "${SOURCE}/CMakeLists.txt" content)
if(content MATCHES "DEUCESSH_PARENT_CRYPTO_TARGET")
	return()
endif()
set(before [=[elseif(DEUCESSH_CRYPTO_BACKEND STREQUAL "OpenSSL")
	find_package(OpenSSL 3.0 REQUIRED)]=])
set(after [=[elseif(DEUCESSH_CRYPTO_BACKEND STREQUAL "OpenSSL")
	if(NOT DEUCESSH_PARENT_CRYPTO_TARGET)
		find_package(OpenSSL 3.0 REQUIRED)
	endif()]=])
string(FIND "${content}" "${before}" position)
if(position EQUAL -1)
	message(FATAL_ERROR "Pinned DeuceSSH provider patch no longer applies")
endif()
string(REPLACE "${before}" "${after}" content "${content}")
set(before [=[	set(DSSH_CRYPTO_LIB_PRIVATE OpenSSL::Crypto)
	set(DSSH_CRYPTO_LIB_INTERFACE ${OPENSSL_CRYPTO_LIBRARIES})
	set(DSSH_CRYPTO_INCLUDE ${OPENSSL_INCLUDE_DIR})]=])
set(after [=[	if(DEUCESSH_PARENT_CRYPTO_TARGET)
		set(DSSH_CRYPTO_LIB_PRIVATE ${DEUCESSH_PARENT_CRYPTO_TARGET})
		set(DSSH_CRYPTO_LIB_INTERFACE "")
		get_target_property(DSSH_CRYPTO_INCLUDE ${DEUCESSH_PARENT_CRYPTO_TARGET} INTERFACE_INCLUDE_DIRECTORIES)
	else()
		set(DSSH_CRYPTO_LIB_PRIVATE OpenSSL::Crypto)
		set(DSSH_CRYPTO_LIB_INTERFACE ${OPENSSL_CRYPTO_LIBRARIES})
		set(DSSH_CRYPTO_INCLUDE ${OPENSSL_INCLUDE_DIR})
	endif()]=])
string(FIND "${content}" "${before}" position)
if(position EQUAL -1)
	message(FATAL_ERROR "Pinned DeuceSSH link patch no longer applies")
endif()
string(REPLACE "${before}" "${after}" content "${content}")
file(WRITE "${SOURCE}/CMakeLists.txt" "${content}")
