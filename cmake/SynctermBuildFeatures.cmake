include_guard(GLOBAL)

# Component-local probe results remain internal, attached to their owner.
function(syncterm_export_configuration target)
	set_property(TARGET ${target} PROPERTY SYNCTERM_CONFIG_KEYS "${ARGN}")
	foreach(key IN LISTS ARGN)
		set(value "${${key}}")
		if(key MATCHES "_HAVE_" OR key STREQUAL "ST_CONSOLE_TEST")
			if(value)
				set(value 1)
			else()
				set(value 0)
			endif()
		endif()
		set_property(TARGET ${target} PROPERTY SYNCTERM_CONFIG_${key} "${value}")
	endforeach()
endfunction()

function(syncterm_c_string input output)
	string(REPLACE "\\" "\\\\" value "${input}")
	string(REPLACE "\"" "\\\"" value "${value}")
	string(REPLACE "\n" "\\n" value "${value}")
	string(REPLACE "\r" "\\r" value "${value}")
	set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(syncterm_dependency_description name output)
	string(TOLOWER "${name}" lower)
	set(target st_dep_${lower})
	set(description "")
	if(TARGET ${target})
		foreach(field LINKAGE SOURCE VERSION PATH INCLUDE PENDING)
			get_property(${field} TARGET ${target} PROPERTY ST_DEP_${field})
		endforeach()
		set(description "${LINKAGE}; ${SOURCE}")
		if(VERSION)
			string(APPEND description "; version ${VERSION}")
		endif()
		if(PENDING)
			string(APPEND description "; source build scheduled")
		endif()
		if(LINKAGE STREQUAL "RUNTIME")
			string(APPEND description "; runtime availability not checked")
		endif()
	endif()
	set(${output} "${description}" PARENT_SCOPE)
endfunction()

macro(_syncterm_feature category label enabled option detail expression)
	if(${enabled})
		set(_state enabled)
		set(_bool true)
	else()
		set(_state disabled)
		set(_bool false)
	endif()
	set(_note "${detail}")
	if(NOT "${option}" STREQUAL "")
		if(DEFINED ${option})
			set(_request "${${option}}")
		else()
			set(_request AUTO)
		endif()
		if(_request STREQUAL "")
			set(_request AUTO)
		endif()
		set(_note "${option}=${_request}; ${_note}")
		if(_state STREQUAL "disabled")
			if(_request STREQUAL "OFF")
				string(APPEND _note "; disabled by request")
			else()
				if((WIN32 OR APPLE) AND "${option}" MATCHES "^(ST_CONSOLE_(SDL|X11|WAYLAND)|ST_AUDIO_(SDL|PORTAUDIO|ALSA|PULSE_AUDIO|PIPEWIRE)|ST_MIDI_(ALSA|FLUIDSYNTH|ADLMIDI))$")
					string(APPEND _note "; native backend preferred by AUTO policy")
				elseif("${option}" STREQUAL "CRYPTO_BACKEND")
					string(APPEND _note "; provider ${crypto} selected")
				else()
					string(APPEND _note "; required development headers/API or platform capability unavailable")
				endif()
			endif()
		endif()
	endif()
	if(NOT _category STREQUAL "${category}")
		set(_category "${category}")
		string(APPEND _report "\n${category}\n")
	endif()
	string(APPEND _report "  ${label}: ${_state} (${_note})\n")
	set(_expression "${expression}")
	if(_expression STREQUAL "")
		set(_expression "${_bool}")
	endif()
	syncterm_c_string("${category}" _category_c)
	syncterm_c_string("${label}" _label_c)
	string(APPEND _code "ST_BUILD_OPTION(${_category_c}, ${_label_c}, ${_expression})\n")
	math(EXPR _count "${_count} + 1")
endmacro()

function(syncterm_generate_build_features)
	foreach(target st_console st_audio st_music st_audio_file st_pixel_image)
		get_property(keys TARGET ${target} PROPERTY SYNCTERM_CONFIG_KEYS)
		foreach(key IN LISTS keys)
			get_property(${key} TARGET ${target} PROPERTY SYNCTERM_CONFIG_${key})
		endforeach()
	endforeach()
	get_property(crypto TARGET st_crypto PROPERTY ST_CRYPTO_PROVIDER)
	set(_report "SyncTERM configuration\nTarget: ${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}\nBuild type: ${CMAKE_BUILD_TYPE}\nC standard: ${SYNCTERM_C_STANDARD}\n")
	if(APPLE)
		string(APPEND _report "macOS architectures: ${CMAKE_OSX_ARCHITECTURES}\nmacOS deployment target: ${CMAKE_OSX_DEPLOYMENT_TARGET}\n")
	endif()
	set(_code "/* Generated from the same inventory as syncterm-configuration.txt. */\n")
	set(_category "")
	set(_count 0)
	_syncterm_feature(Fonts "Unifont (SyncTERM Unicode)" SYNCTERM_ENABLE_UNIFONT SYNCTERM_ENABLE_UNIFONT "compiled font" "")
	foreach(font UNSCII "Noto Emoji" "Noto Color Emoji")
		_syncterm_feature(Fonts "${font}" TRUE "" "compiled font" "")
	endforeach()
	set(have_crypto FALSE)
	set(have_openssl FALSE)
	set(have_botan FALSE)
	if(NOT crypto STREQUAL "none")
		set(have_crypto TRUE)
	endif()
	if(crypto STREQUAL "OpenSSL")
		set(have_openssl TRUE)
	elseif(crypto STREQUAL "Botan")
		set(have_botan TRUE)
	endif()
	_syncterm_feature(Crypto "DeuceSSH (SSH)" have_crypto CRYPTO_BACKEND "provider ${crypto}" "")
	_syncterm_feature(Crypto "OpenSSL (TLS, symmetric ciphers)" have_openssl CRYPTO_BACKEND "provider ${crypto}" "")
	_syncterm_feature(Crypto "Botan 3 (TLS, symmetric ciphers)" have_botan CRYPTO_BACKEND "provider ${crypto}" "")
	_syncterm_feature(Crypto "Encrypted BBS lists" have_crypto "" "provider ${crypto}; runtime capability checked by application" "st_list_crypto_encryption_available()")
	_syncterm_feature(Terminal "Operation Overkill ][ Terminal" TRUE "" "built in" "")
	syncterm_dependency_description(JXL detail)
	_syncterm_feature(Terminal "JPEG XL support" _st_pixel_image_have_jxl ST_PIXEL_IMAGE_JXL "${detail}" "")
	foreach(pair "SDL|SDL" "X11|X11 Support" "XINERAMA|Xinerama" "XRANDR|XRandR" "XRENDER|XRender" "GDI|GDI" "WAYLAND|Wayland" "QUARTZ|Quartz" "WIN32|Win32 Console" "CURSES_H|ncurses" "ANSI|ANSI" "LIBRETRO|libretro" "TEST|Testing bitmap backend")
		string(REPLACE "|" ";" fields "${pair}")
		list(GET fields 0 key)
		list(GET fields 1 label)
		set(option "")
		set(detail "built in")
		if(key MATCHES "^(SDL|X11|WAYLAND|TEST|XRENDER|XRANDR|XINERAMA)$")
			set(option ST_CONSOLE_${key})
		elseif(key STREQUAL "CURSES_H")
			set(option ST_CONSOLE_CURSES)
		endif()
		if(key MATCHES "^(SDL|X11|XINERAMA|XRANDR|XRENDER|WAYLAND|CURSES_H)$")
			set(detail "runtime loaded; runtime availability not checked")
		elseif(key MATCHES "^(GDI|QUARTZ|WIN32)$")
			set(detail "system linked")
		endif()
		if(key STREQUAL "WAYLAND")
			string(APPEND detail "; wayland-client and xkbcommon")
		elseif(key STREQUAL "CURSES_H")
			string(APPEND detail "; implementation=${ST_CONSOLE_CURSES_IMPLEMENTATION}, timeout=${ST_CONSOLE_HAVE_CURSES_TIMEOUT}, wide=${ST_CONSOLE_HAVE_CURSES_WIDE}, extended colours=${ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR}")
		endif()
		set(dep "${key}")
		if(key STREQUAL "SDL")
			set(dep SDL2)
		elseif(key STREQUAL "CURSES_H")
			set(dep CURSES)
		endif()
		syncterm_dependency_description(${dep} description)
		if(description)
			set(detail "${description}")
			if(dep STREQUAL "CURSES")
				string(APPEND detail "; implementation=${ST_CONSOLE_CURSES_IMPLEMENTATION}, timeout=${ST_CONSOLE_HAVE_CURSES_TIMEOUT}, wide=${ST_CONSOLE_HAVE_CURSES_WIDE}, extended colours=${ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR}")
			endif()
		endif()
		if(key STREQUAL "TEST")
			set(have "${ST_CONSOLE_TEST}")
		elseif(key MATCHES "^(ANSI|LIBRETRO)$")
			set(have TRUE)
		else()
			set(have "${ST_CONSOLE_HAVE_${key}}")
		endif()
		_syncterm_feature(Video "${label}" have "${option}" "${detail}" "")
	endforeach()
	foreach(pair "OSS|OSS" "SDL|SDL" "ALSA|ALSA" "WASAPI|WASAPI" "PORTAUDIO|PortAudio" "PIPEWIRE|PipeWire" "PULSE_AUDIO|PulseAudio" "CORE_AUDIO|Core Audio")
		string(REPLACE "|" ";" fields "${pair}")
		list(GET fields 0 key)
		list(GET fields 1 label)
		set(have "${ST_AUDIO_HAVE_${key}}")
		set(detail "runtime loaded; runtime availability not checked")
		if(key MATCHES "^(OSS|WASAPI|CORE_AUDIO)$")
			set(detail "system linked")
		endif()
		set(dep "${key}")
		if(key STREQUAL "SDL")
			set(dep SDL2)
		elseif(key STREQUAL "PULSE_AUDIO")
			set(dep PULSEAUDIO)
		endif()
		syncterm_dependency_description(${dep} description)
		if(description)
			set(detail "${description}")
		endif()
		_syncterm_feature(Audio "${label}" have ST_AUDIO_${key} "${detail}" "")
	endforeach()
	syncterm_dependency_description(SNDFILE detail)
	if(TARGET st_dep_sndfile)
		get_property(source TARGET st_dep_sndfile PROPERTY ST_DEP_SOURCE)
		if(source STREQUAL "BUNDLED")
			string(APPEND detail "; pinned codec set: FLAC, Ogg/Vorbis, Opus, MP3 (mpg123/LAME)")
		else()
			string(APPEND detail "; installed codec availability checked at runtime")
		endif()
	endif()
	_syncterm_feature(Audio libsndfile ST_AUDIO_FILE_HAVE_SNDFILE ST_AUDIO_FILE_SNDFILE "${detail}" "")
	foreach(pair "WINMM|WinMM" "APPLE|Apple DLS" "ALSA|ALSA Sequencer" "FLUIDSYNTH|FluidSynth" "ADLMIDI|libADLMIDI")
		string(REPLACE "|" ";" fields "${pair}")
		list(GET fields 0 key)
		list(GET fields 1 label)
		set(link "${ST_MIDI_LINK_${key}}")
		set(suffix "")
		set(detail "not built")
		if(link EQUAL 1)
			set(suffix " (runtime loaded)")
			set(detail "runtime loaded; runtime availability not checked")
		elseif(link EQUAL 2)
			set(suffix " (static)")
			set(detail "static")
		elseif(link EQUAL 4)
			set(suffix " (shared)")
			set(detail "shared")
		elseif(link EQUAL 3)
			set(suffix " (system linked)")
			set(detail "system linked")
		endif()
		_syncterm_feature(MIDI "${label}${suffix}" link ST_MIDI_${key} "${detail}" "")
	endforeach()
	string(APPEND _report "\nBuild Options items: ${_count}\nTests: ${BUILD_TESTING}\n")
	get_property(dependencies GLOBAL PROPERTY SYNCTERM_RESOLVED_DEPENDENCIES)
	list(REMOVE_DUPLICATES dependencies)
	string(APPEND _report "\nDependencies\n")
	foreach(dep IN LISTS dependencies)
		syncterm_dependency_description(${dep} detail)
		string(TOLOWER "${dep}" lower)
		get_property(path TARGET st_dep_${lower} PROPERTY ST_DEP_PATH)
		get_property(headers TARGET st_dep_${lower} PROPERTY ST_DEP_INCLUDE)
		string(APPEND _report "  ${dep}: ${detail}\n    ST_DEP_${dep}_LINKAGE=${ST_DEP_${dep}_LINKAGE}; ST_DEP_${dep}_SOURCE=${ST_DEP_${dep}_SOURCE}\n    Headers: ${headers}\n    Libraries/staging: ${path}\n")
	endforeach()
	get_property(transitive_targets GLOBAL PROPERTY SYNCTERM_TRANSITIVE_LINK_TARGETS)
	list(REMOVE_DUPLICATES transitive_targets)
	foreach(target IN LISTS transitive_targets)
		get_property(path TARGET ${target} PROPERTY ST_DEP_PATH)
		get_property(source TARGET ${target} PROPERTY ST_DEP_SOURCE)
		get_property(version TARGET ${target} PROPERTY ST_DEP_VERSION)
		string(APPEND _report "  ${target}: SHARED transitive link closure for a runtime adapter; ${source}; version ${version}\n    Libraries/staging: ${path}\n")
	endforeach()
	set(directory "${PROJECT_BINARY_DIR}/syncterm-generated")
	file(MAKE_DIRECTORY "${directory}")
	file(CONFIGURE OUTPUT "${directory}/st_build_options.inc" CONTENT "${_code}" @ONLY)
	file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/syncterm-configuration.txt" CONTENT "${_report}" @ONLY)
endfunction()

function(syncterm_print_configuration)
	file(READ "${PROJECT_BINARY_DIR}/syncterm-configuration.txt" report)
	string(REPLACE "\n" "\n-- " report "${report}")
	message(STATUS "${report}")
endfunction()
