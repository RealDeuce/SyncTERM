option(SYNCTERM_DEPENDENCY_DOWNLOADS "Download pinned dependency sources when needed" ON)
set(SYNCTERM_DEPENDENCY_CACHE "${CMAKE_BINARY_DIR}/dependency-downloads" CACHE PATH
	"Cache of hash-verified dependency source archives")

function(syncterm_dependency_math target)
	set(CMAKE_REQUIRED_LIBRARIES "")
	set(probe "#include <math.h>\nint main(void) { double (*volatile f)(double) = floor; return f(0.5) != 0; }")
	syncterm_check_c17_source("${probe}" ST_DEP_MATH_IN_LIBC)
	if(NOT ST_DEP_MATH_IN_LIBC)
		set(CMAKE_REQUIRED_LIBRARIES m)
		syncterm_check_c17_source("${probe}" ST_DEP_MATH_IN_LIBM)
		if(ST_DEP_MATH_IN_LIBM)
			target_link_libraries(${target} INTERFACE m)
		endif()
	endif()
endfunction()

function(syncterm_dependency_options name default_linkage)
	# A library has one AUTO policy regardless of which consumer resolves it
	# first. Direct consumers of a runtime-loaded library use a link closure
	# without changing the adapter's policy.
	if(name MATCHES "^(SNDFILE|JXL|SDL2|ALSA|PORTAUDIO|FLUIDSYNTH|ADLMIDI|PULSEAUDIO|PIPEWIRE|X11|XRENDER|XRANDR|XINERAMA|WAYLAND|XKBCOMMON)$")
		set(default_linkage RUNTIME)
	endif()
	set(ST_DEP_${name}_LINKAGE AUTO CACHE STRING "${name} linkage: AUTO, STATIC, SHARED, RUNTIME")
	set_property(CACHE ST_DEP_${name}_LINKAGE PROPERTY STRINGS AUTO STATIC SHARED RUNTIME)
	set(ST_DEP_${name}_SOURCE AUTO CACHE STRING "${name} source: AUTO, INSTALLED, BUNDLED")
	set_property(CACHE ST_DEP_${name}_SOURCE PROPERTY STRINGS AUTO INSTALLED BUNDLED)
	set(ST_DEP_${name}_ROOT "" CACHE PATH "Preferred installed ${name} prefix")
	set(ST_DEP_${name}_INCLUDE_DIR "" CACHE PATH "Explicit installed ${name} header directory")
	set(ST_DEP_${name}_LIBRARIES "" CACHE STRING "Explicit installed ${name} library paths and link dependencies")
	set(ST_DEP_${name}_ARCHIVE "" CACHE FILEPATH "Local copy of the pinned ${name} source archive")
	if(NOT ST_DEP_${name}_LINKAGE MATCHES "^(AUTO|STATIC|SHARED|RUNTIME)$")
		message(FATAL_ERROR "Invalid ST_DEP_${name}_LINKAGE=${ST_DEP_${name}_LINKAGE}")
	endif()
	if(NOT ST_DEP_${name}_SOURCE MATCHES "^(AUTO|INSTALLED|BUNDLED)$")
		message(FATAL_ERROR "Invalid ST_DEP_${name}_SOURCE=${ST_DEP_${name}_SOURCE}")
	endif()
	set(mode "${ST_DEP_${name}_LINKAGE}")
	if(mode STREQUAL "AUTO")
		if(default_linkage STREQUAL "NATIVE")
			set(mode SHARED)
		elseif(WIN32 OR APPLE)
			set(mode STATIC)
		else()
			set(mode "${default_linkage}")
		endif()
	endif()
	set(ST_DEP_${name}_MODE "${mode}" PARENT_SCOPE)
endfunction()

function(syncterm_is_static_archive path output)
	set(${output} FALSE PARENT_SCOPE)
	if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR path MATCHES "\\.dll\\.a$")
		return()
	endif()
	file(READ "${path}" magic LIMIT 8 HEX)
	if(magic STREQUAL "213c617263683e0a" OR magic STREQUAL "213c7468696e3e0a")
		if(WIN32)
			file(STRINGS "${path}" imports REGEX "__IMPORT_DESCRIPTOR_" LIMIT_COUNT 1)
			if(imports)
				return()
			endif()
		endif()
		set(${output} TRUE PARENT_SCOPE)
		return()
	endif()
	string(LENGTH "${magic}" length)
	if(length LESS 16)
		return()
	endif()
	string(SUBSTRING "${magic}" 0 8 format)
	if(NOT format STREQUAL "cafebabe" AND NOT format STREQUAL "cafebabf")
		return()
	endif()
	string(SUBSTRING "${magic}" 8 8 count_hex)
	math(EXPR count "0x${count_hex}")
	if(count LESS 1 OR count GREATER 1024)
		return()
	endif()
	set(entry 20)
	set(offset_bytes 4)
	if(format STREQUAL "cafebabf")
		set(entry 32)
		set(offset_bytes 8)
	endif()
	math(EXPR header "8 + ${count} * ${entry}")
	file(SIZE "${path}" size)
	if(size LESS header)
		return()
	endif()
	math(EXPR last "${count} - 1")
	math(EXPR end "${size} - 8")
	foreach(i RANGE 0 ${last})
		math(EXPR pos "16 + ${i} * ${entry}")
		file(READ "${path}" offset_hex OFFSET ${pos} LIMIT ${offset_bytes} HEX)
		math(EXPR offset "0x${offset_hex}")
		if(offset LESS header OR offset GREATER end)
			return()
		endif()
		file(READ "${path}" slice OFFSET ${offset} LIMIT 8 HEX)
		if(NOT slice STREQUAL "213c617263683e0a" AND NOT slice STREQUAL "213c7468696e3e0a")
			return()
		endif()
	endforeach()
	set(${output} TRUE PARENT_SCOPE)
endfunction()

function(syncterm_library_dependency library output)
	set(result "")
	foreach(pair "FLAC|FLAC" "ogg|OGG" "vorbis|VORBIS" "vorbisenc|VORBIS"
		"opus|OPUS" "mpg123|MPG123" "mp3lame|LAME" "sndfile|SNDFILE"
		"hwy|HIGHWAY" "brotlidec|BROTLI" "brotlicommon|BROTLI" "lcms2|LCMS2"
		"X11|X11" "Xext|XEXT" "Xrender|XRENDER" "Xrandr|XRANDR" "Xinerama|XINERAMA"
		"Xau|XAU" "Xdmcp|XDMCP" "xcb|XCB" "ffi|FFI" "expat|EXPAT")
		string(REPLACE "|" ";" fields "${pair}")
		list(GET fields 0 candidate)
		if(library STREQUAL candidate)
			list(GET fields 1 result)
			break()
		endif()
	endforeach()
	set(${output} "${result}" PARENT_SCOPE)
endfunction()

# Model ordered archive dependencies on the archives themselves. An interface
# containing sibling archive filenames loses these edges when CMake removes
# duplicates, which can place Ogg before Vorbis on a one-pass GNU linker.
function(syncterm_dependency_link_libraries target mode)
	set(items ${ARGN})
	set(archives)
	list(LENGTH items count)
	if(count GREATER 0 AND mode STREQUAL "STATIC")
		math(EXPR last "${count} - 1")
		foreach(index RANGE 0 ${last})
			list(GET items ${index} library)
			if(IS_ABSOLUTE "${library}" AND EXISTS "${library}")
				syncterm_is_static_archive("${library}" static)
				if(static)
					string(SHA256 id "${target};${index};${library}")
					set(imported st_archive_${id})
					add_library(${imported} STATIC IMPORTED GLOBAL)
					set_property(TARGET ${imported} PROPERTY IMPORTED_LOCATION "${library}")
					list(REMOVE_AT items ${index})
					list(INSERT items ${index} ${imported})
					list(APPEND archives ${index})
				endif()
			elseif(library MATCHES "^st_product_" AND TARGET ${library})
				list(APPEND archives ${index})
			endif()
		endforeach()
		foreach(index IN LISTS archives)
			list(GET items ${index} archive)
			math(EXPR next "${index} + 1")
			set(dependencies)
			if(next LESS count)
				list(SUBLIST items ${next} -1 dependencies)
			endif()
			set_property(TARGET ${archive} PROPERTY INTERFACE_LINK_LIBRARIES "${dependencies}")
		endforeach()
	endif()
	target_link_libraries(${target} INTERFACE ${items})
endfunction()

# A single resolved target is shared by every consumer of a dependency.
function(syncterm_dependency)
	cmake_parse_arguments(PARSE_ARGV 0 DEP "REQUIRED;CXX;ALTERNATIVES;LINK_REQUIRED" "NAME;PACKAGE;HEADER;DEFAULT;PROBE"
		"LIBRARIES;DEFINITIONS")
	set(name "${DEP_NAME}")
	set(pending_configs)
	set(configurations ${CMAKE_CONFIGURATION_TYPES} "${CMAKE_BUILD_TYPE}")
	if(NOT configurations)
		set(configurations Release)
	endif()
	foreach(config IN LISTS configurations)
		set(pending_builds_${config})
	endforeach()
	syncterm_dependency_options(${name} "${DEP_DEFAULT}")
	set(mode "${ST_DEP_${name}_MODE}")
	if(ST_DEP_${name}_SOURCE STREQUAL "BUNDLED" AND
		(ST_DEP_${name}_LIBRARIES OR ST_DEP_${name}_INCLUDE_DIR OR ST_DEP_${name}_ROOT))
		message(FATAL_ERROR "${name}: BUNDLED sources cannot use installed ROOT, INCLUDE_DIR or LIBRARIES overrides")
	endif()
	if(mode STREQUAL "STATIC")
		if(name STREQUAL "JXL")
			list(APPEND DEP_DEFINITIONS -DJXL_STATIC_DEFINE -DJXL_THREADS_STATIC_DEFINE -DJXL_CMS_STATIC_DEFINE)
		elseif(name STREQUAL "SDL2")
			list(APPEND DEP_DEFINITIONS -DSDL_STATIC_LIB)
		elseif(name STREQUAL "FLUIDSYNTH")
			list(APPEND DEP_DEFINITIONS -DFLUIDSYNTH_NOT_A_DLL)
		elseif(name STREQUAL "FLAC")
			list(APPEND DEP_DEFINITIONS -DFLAC__NO_DLL)
		elseif(name STREQUAL "EXPAT")
			list(APPEND DEP_DEFINITIONS -DXML_STATIC)
		endif()
	endif()
	string(TOLOWER "${name}" lower)
	set(target st_dep_${lower})
	# A runtime-loaded adapter may also supply a dependency of a directly
	# linked library. That consumer needs a real shared link closure, while
	# the adapter continues using its runtime function table.
	if(DEP_LINK_REQUIRED AND mode STREQUAL "RUNTIME")
		set(mode SHARED)
		set(target st_dep_${lower}_link)
	endif()
	if(TARGET ${target})
		get_property(resolved TARGET ${target} PROPERTY ST_DEP_LINKAGE)
		if(NOT mode STREQUAL resolved)
			message(FATAL_ERROR "Conflicting ${name} linkage requests: ${resolved}, ${mode}")
		endif()
		set(ST_DEP_${name}_TARGET ${target} PARENT_SCOPE)
		set(ST_DEP_${name}_MODE ${mode} PARENT_SCOPE)
		return()
	endif()
	set(ST_DEP_${name}_TARGET "" PARENT_SCOPE)
	set(ST_DEP_${name}_MODE ${mode} PARENT_SCOPE)
	set(root "${ST_DEP_${name}_ROOT}")
	set(native_sdk FALSE)
	if(APPLE AND DEP_DEFAULT STREQUAL "NATIVE" AND ST_DEP_${name}_LINKAGE STREQUAL "AUTO"
	    AND NOT ST_DEP_${name}_SOURCE STREQUAL "BUNDLED" AND NOT root
	    AND NOT ST_DEP_${name}_INCLUDE_DIR AND NOT ST_DEP_${name}_LIBRARIES)
		# Native curses/terminfo must not pick up a Homebrew dylib merely
		# because pkg-config or a package prefix is present on the host.
		set(sdk "${CMAKE_OSX_SYSROOT}")
		if(NOT IS_DIRECTORY "${sdk}")
			find_program(xcrun NAMES xcrun REQUIRED)
			set(sdk_args)
			if(sdk)
				set(sdk_args --sdk "${sdk}")
			endif()
			execute_process(COMMAND "${xcrun}" ${sdk_args} --show-sdk-path
				OUTPUT_VARIABLE sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
		endif()
		set(root "${sdk}/usr")
		set(native_sdk TRUE)
		foreach(field FOUND PREFIX INCLUDE_DIRS CFLAGS_OTHER STATIC_LIBRARIES
			LIBRARY_DIRS STATIC_LIBRARY_DIRS VERSION STATIC_LDFLAGS_OTHER)
			set(ST_PC_${name}_${field} "")
		endforeach()
	endif()
	set(found FALSE)
	if(NOT ST_DEP_${name}_SOURCE STREQUAL "BUNDLED")
		find_package(PkgConfig QUIET)
		# Host pkg-config installations are not target dependencies.
		if(PkgConfig_FOUND AND NOT native_sdk AND (NOT CMAKE_CROSSCOMPILING OR root OR DEFINED ENV{PKG_CONFIG_SYSROOT_DIR}))
			set(saved_pkg_path "$ENV{PKG_CONFIG_PATH}")
			set(saved_pkg_libdir "$ENV{PKG_CONFIG_LIBDIR}")
			set(had_pkg_libdir FALSE)
			if(DEFINED ENV{PKG_CONFIG_LIBDIR})
				set(had_pkg_libdir TRUE)
			endif()
			if(root)
				set(separator ":")
				if(CMAKE_HOST_WIN32)
					set(separator ";")
				endif()
				set(ENV{PKG_CONFIG_PATH} "${root}/lib/pkgconfig${separator}${root}/share/pkgconfig${separator}${saved_pkg_path}")
				set(ENV{PKG_CONFIG_LIBDIR} "${root}/lib/pkgconfig${separator}${root}/share/pkgconfig")
			endif()
			unset(__pkg_config_checked_ST_PC_${name} CACHE)
			pkg_check_modules(ST_PC_${name} QUIET "${DEP_PACKAGE}")
			set(ENV{PKG_CONFIG_PATH} "${saved_pkg_path}")
			if(had_pkg_libdir)
				set(ENV{PKG_CONFIG_LIBDIR} "${saved_pkg_libdir}")
			else()
				unset(ENV{PKG_CONFIG_LIBDIR})
			endif()
		endif()
		set(hints "${root}" ${ST_PC_${name}_PREFIX})
		if(APPLE AND NOT CMAKE_CROSSCOMPILING AND NOT root)
			find_program(brew NAMES brew)
			if(brew)
				execute_process(COMMAND "${brew}" --prefix OUTPUT_VARIABLE brew_prefix
					OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE brew_result)
				if(brew_result EQUAL 0)
					list(APPEND hints "${brew_prefix}")
				endif()
			endif()
		endif()
		if(ST_DEP_${name}_INCLUDE_DIR)
			set(include_dir "${ST_DEP_${name}_INCLUDE_DIR}")
		else()
			unset(include_dir)
			if(root)
				find_path(include_dir NAMES "${DEP_HEADER}" PATHS "${root}"
					PATH_SUFFIXES include include/botan-3 include/SDL2 include/pipewire-0.3 include/ncursesw include/ncurses
					NO_DEFAULT_PATH NO_CACHE)
			else()
				find_path(include_dir NAMES "${DEP_HEADER}" HINTS ${hints} ${ST_PC_${name}_INCLUDE_DIRS}
					PATH_SUFFIXES include include/botan-3 include/SDL2 include/pipewire-0.3 include/ncursesw include/ncurses NO_CACHE)
			endif()
		endif()
		set(libraries)
		set(probe_libraries)
		set(pending FALSE)
		set(missing FALSE)
		set(names ${DEP_LIBRARIES})
		if(mode STREQUAL "STATIC" AND ST_PC_${name}_FOUND)
			if(DEP_ALTERNATIVES)
				set(names ${ST_PC_${name}_STATIC_LIBRARIES})
			else()
				list(APPEND names ${ST_PC_${name}_STATIC_LIBRARIES})
				list(REMOVE_DUPLICATES names)
			endif()
			set(DEP_ALTERNATIVES FALSE)
		endif()
		if(ST_DEP_${name}_LIBRARIES)
			set(libraries ${ST_DEP_${name}_LIBRARIES})
			set(probe_libraries ${libraries})
			set(names)
			foreach(location IN LISTS libraries)
				if(IS_ABSOLUTE "${location}")
					if(NOT EXISTS "${location}")
						message(FATAL_ERROR "Explicit ${name} library does not exist: ${location}")
					endif()
					if(NOT mode STREQUAL "RUNTIME")
						syncterm_is_static_archive("${location}" valid)
						if(mode STREQUAL "STATIC" AND NOT valid)
							message(FATAL_ERROR "Explicit ${name} library is not a static archive: ${location}")
						elseif(mode STREQUAL "SHARED" AND valid)
							message(FATAL_ERROR "Explicit ${name} library is not a shared library: ${location}")
						endif()
					endif()
				endif()
			endforeach()
		endif()
		if(mode STREQUAL "STATIC")
			if(WIN32)
				set(CMAKE_FIND_LIBRARY_SUFFIXES .a .lib)
			else()
				set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
			endif()
		elseif(mode STREQUAL "SHARED")
			if(WIN32)
				set(CMAKE_FIND_LIBRARY_SUFFIXES .dll.a .lib)
			elseif(APPLE)
				set(CMAKE_FIND_LIBRARY_SUFFIXES .tbd .dylib .so)
			else()
				set(CMAKE_FIND_LIBRARY_SUFFIXES .so)
			endif()
		endif()
		if(NOT mode STREQUAL "RUNTIME")
			foreach(library IN LISTS names)
				if(library MATCHES "^(m|dl|pthread|rt|c|stdc\\+\\+|c\\+\\+)$" OR
					(WIN32 AND library MATCHES "^(winmm|ole32|oleaut32|uuid|setupapi|version|imm32|cfgmgr32|ksuser|avrt|shell32|shlwapi|gdi32|user32|advapi32|ws2_32|crypt32|bcrypt|iphlpapi|secur32)$"))
					list(APPEND libraries "${library}")
					list(APPEND probe_libraries "${library}")
					continue()
				endif()
				if(APPLE AND library MATCHES "^(z|bz2|iconv|resolv|objc|System)$")
					# SDK libraries remain system dependencies in a static build.
					set(saved_suffixes "${CMAKE_FIND_LIBRARY_SUFFIXES}")
					set(CMAKE_FIND_LIBRARY_SUFFIXES .tbd .dylib)
					unset(system_library)
					find_library(system_library NAMES "${library}" PATHS
						"${CMAKE_OSX_SYSROOT}/usr/lib" /usr/lib NO_DEFAULT_PATH NO_CACHE)
					set(CMAKE_FIND_LIBRARY_SUFFIXES "${saved_suffixes}")
					if(system_library)
						list(APPEND libraries "${system_library}")
						list(APPEND probe_libraries "${system_library}")
						continue()
					endif()
				endif()
				if(NOT library IN_LIST DEP_LIBRARIES AND NOT DEP_ALTERNATIVES)
					syncterm_library_dependency("${library}" child)
					if(child AND NOT child STREQUAL name)
						include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Recipes.cmake")
						syncterm_dependency_recipe(${child})
						set(cxx)
						if(child STREQUAL "HIGHWAY")
							set(cxx CXX)
						endif()
						syncterm_dependency(NAME ${child} PACKAGE "${recipe_package}" HEADER "${recipe_header}"
							LIBRARIES ${recipe_libs} DEFAULT SHARED REQUIRED LINK_REQUIRED ${cxx}
							PROBE "#include <${recipe_header}>\nint main(void) { return 0; }")
						list(APPEND libraries ${ST_DEP_${child}_TARGET})
						get_property(child_libraries TARGET ${ST_DEP_${child}_TARGET} PROPERTY ST_DEP_PROBE_LIBRARIES)
						get_property(child_pending TARGET ${ST_DEP_${child}_TARGET} PROPERTY ST_DEP_PENDING)
						list(APPEND probe_libraries ${child_libraries})
						if(child_pending)
							set(pending TRUE)
							get_property(child_configs TARGET ${ST_DEP_${child}_TARGET} PROPERTY ST_DEP_BUILD_CONFIGURATIONS)
							foreach(config IN LISTS child_configs)
								list(APPEND pending_configs "${config}")
								get_property(child_builds TARGET ${ST_DEP_${child}_TARGET} PROPERTY ST_DEP_BUILD_TARGETS_${config})
								list(APPEND pending_builds_${config} ${child_builds})
							endforeach()
						endif()
						continue()
					endif()
				endif()
				unset(location)
				if(root AND library IN_LIST DEP_LIBRARIES)
					find_library(location NAMES ${library} PATHS "${root}/lib" "${root}/lib64"
						NO_DEFAULT_PATH NO_CACHE)
				else()
					find_library(location NAMES ${library} HINTS ${hints} ${ST_PC_${name}_LIBRARY_DIRS}
						${ST_PC_${name}_STATIC_LIBRARY_DIRS} PATH_SUFFIXES lib NO_CACHE)
				endif()
				if(NOT location)
					if(DEP_ALTERNATIVES)
						continue()
					endif()
					set(missing TRUE)
					break()
				endif()
				if(mode STREQUAL "STATIC")
					syncterm_is_static_archive("${location}" archive)
					if(NOT archive)
						set(missing TRUE)
					endif()
				elseif(mode STREQUAL "SHARED")
					syncterm_is_static_archive("${location}" archive)
					if(archive)
						set(missing TRUE)
					endif()
				endif()
				list(APPEND libraries "${location}")
				list(APPEND probe_libraries "${location}")
				if(DEP_ALTERNATIVES)
					break()
				endif()
			endforeach()
			if(names AND NOT libraries)
				set(missing TRUE)
			endif()
		endif()
		if(include_dir AND NOT missing)
			set(CMAKE_REQUIRED_INCLUDES "${include_dir}" ${ST_PC_${name}_INCLUDE_DIRS})
			if(include_dir MATCHES "/include/(botan-3|SDL2|pipewire-0.3|ncursesw|ncurses)$")
				get_filename_component(include_parent "${include_dir}" DIRECTORY)
				list(APPEND CMAKE_REQUIRED_INCLUDES "${include_parent}")
			endif()
			set(resolved_includes "${CMAKE_REQUIRED_INCLUDES}")
			set(CMAKE_REQUIRED_DEFINITIONS ${DEP_DEFINITIONS})
			list(JOIN ST_PC_${name}_CFLAGS_OTHER " " CMAKE_REQUIRED_FLAGS)
			if(mode STREQUAL "RUNTIME" OR pending)
				set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
				set(CMAKE_REQUIRED_LIBRARIES "")
			else()
				set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
				set(CMAKE_REQUIRED_LIBRARIES ${probe_libraries})
				set(CMAKE_REQUIRED_LINK_OPTIONS ${ST_PC_${name}_STATIC_LDFLAGS_OTHER})
			endif()
			set(fingerprints)
			foreach(input "${include_dir}/${DEP_HEADER}" ${probe_libraries})
				if(EXISTS "${input}" AND NOT IS_DIRECTORY "${input}")
					string(SHA256 key "${input}")
					get_property(digest GLOBAL PROPERTY ST_DEP_INPUT_${key})
					if(NOT digest)
						file(SHA256 "${input}" digest)
						set_property(GLOBAL PROPERTY ST_DEP_INPUT_${key} "${digest}")
					endif()
					list(APPEND fingerprints "${input}=${digest}")
				endif()
			endforeach()
			string(SHA256 signature "${DEP_PROBE};${mode};${CMAKE_REQUIRED_INCLUDES};${libraries};${CMAKE_REQUIRED_DEFINITIONS};${CMAKE_REQUIRED_FLAGS};${CMAKE_REQUIRED_LINK_OPTIONS};${ST_PC_${name}_VERSION};${fingerprints};${CMAKE_C_COMPILER};${CMAKE_CXX_COMPILER};${CMAKE_C_FLAGS};${CMAKE_CXX_FLAGS};${CMAKE_OSX_ARCHITECTURES};${CMAKE_OSX_DEPLOYMENT_TARGET};${CMAKE_OSX_SYSROOT};${CMAKE_SYSROOT};${CMAKE_C_COMPILER_TARGET};${CMAKE_CXX_COMPILER_TARGET};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_BUILD_TYPE};${CMAKE_C_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_TRY_COMPILE_CONFIGURATION}")
			if(DEP_CXX)
				enable_language(CXX)
				include(CheckCXXSourceCompiles)
				set(CMAKE_CXX_STANDARD 20)
				check_cxx_source_compiles("${DEP_PROBE}" ST_DEP_CHECK_${signature})
			else()
				syncterm_check_c17_source("${DEP_PROBE}" ST_DEP_CHECK_${signature})
			endif()
			if(ST_DEP_CHECK_${signature})
				set(found TRUE)
			endif()
		endif()
	endif()
	if(NOT found)
		if(ST_DEP_${name}_LIBRARIES OR ST_DEP_${name}_INCLUDE_DIR)
			message(FATAL_ERROR "Explicit ${name} headers/libraries fail the required API/link check")
		endif()
		if(ST_DEP_${name}_SOURCE STREQUAL "BUNDLED" OR (DEP_REQUIRED AND NOT ST_DEP_${name}_SOURCE STREQUAL "INSTALLED"))
			if(mode STREQUAL "RUNTIME")
				message(FATAL_ERROR "${name}: RUNTIME needs installed development headers; select STATIC or SHARED to build pinned sources")
			endif()
			include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SynctermDependencySources.cmake")
			syncterm_dependency_source(${name} "${mode}" "${DEP_LIBRARIES}")
		target_compile_options(${target} INTERFACE ${DEP_DEFINITIONS})
			if(DEP_LINK_REQUIRED AND ST_DEP_${name}_MODE STREQUAL "RUNTIME")
				set_property(GLOBAL APPEND PROPERTY SYNCTERM_TRANSITIVE_LINK_TARGETS "${target}")
			else()
				set_property(GLOBAL APPEND PROPERTY SYNCTERM_RESOLVED_DEPENDENCIES "${name}")
			endif()
			set(ST_DEP_${name}_TARGET ${target} PARENT_SCOPE)
			return()
		endif()
		if(DEP_REQUIRED)
			message(FATAL_ERROR "No usable installed ${mode} ${name}: check its headers, libraries and transitive dependencies")
		endif()
		return()
	endif()
	add_library(${target} INTERFACE)
	target_include_directories(${target} SYSTEM INTERFACE ${resolved_includes})
	target_compile_options(${target} INTERFACE ${DEP_DEFINITIONS} ${ST_PC_${name}_CFLAGS_OTHER})
	if(DEP_CXX AND NOT mode STREQUAL "RUNTIME")
		list(APPEND libraries ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
		target_link_directories(${target} INTERFACE ${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES})
	endif()
	if(NOT mode STREQUAL "RUNTIME")
		syncterm_dependency_link_libraries(${target} ${mode} ${libraries})
		target_link_options(${target} INTERFACE ${CMAKE_REQUIRED_LINK_OPTIONS})
	endif()
	set_target_properties(${target} PROPERTIES ST_DEP_LINKAGE "${mode}"
		ST_DEP_SOURCE INSTALLED ST_DEP_VERSION "${ST_PC_${name}_VERSION}"
		ST_DEP_PATH "${libraries}" ST_DEP_INCLUDE "${include_dir}"
		ST_DEP_PROBE_LIBRARIES "${probe_libraries}" ST_DEP_PENDING "${pending}")
	if(mode STREQUAL "RUNTIME")
		set_property(TARGET ${target} PROPERTY ST_DEP_PATH "system loader: ${DEP_LIBRARIES}")
	endif()
	set(prefix "${root}")
	if(NOT prefix)
		set(prefix "${ST_PC_${name}_PREFIX}")
	endif()
	if(NOT prefix)
		get_filename_component(prefix "${include_dir}" DIRECTORY)
	endif()
	set_property(TARGET ${target} PROPERTY ST_DEP_PREFIX "${prefix}")
	list(REMOVE_DUPLICATES pending_configs)
	set_property(TARGET ${target} PROPERTY ST_DEP_BUILD_CONFIGURATIONS "${pending_configs}")
	foreach(config IN LISTS pending_configs)
		set_property(TARGET ${target} PROPERTY ST_DEP_BUILD_TARGETS_${config} "${pending_builds_${config}}")
	endforeach()
	if(DEP_LINK_REQUIRED AND ST_DEP_${name}_MODE STREQUAL "RUNTIME")
		set_property(GLOBAL APPEND PROPERTY SYNCTERM_TRANSITIVE_LINK_TARGETS "${target}")
	else()
		set_property(GLOBAL APPEND PROPERTY SYNCTERM_RESOLVED_DEPENDENCIES "${name}")
	endif()
	set(ST_DEP_${name}_TARGET ${target} PARENT_SCOPE)
endfunction()

# Stage only pinned shared dependencies; installed libraries retain their normal
# platform/package search and deployment rules. Called from the app's directory.
function(syncterm_stage_dependency_runtime target)
	if(NOT WIN32)
		return()
	endif()
	get_property(names GLOBAL PROPERTY SYNCTERM_RESOLVED_DEPENDENCIES)
	get_property(targets GLOBAL PROPERTY SYNCTERM_TRANSITIVE_LINK_TARGETS)
	foreach(name IN LISTS names)
		string(TOLOWER "${name}" lower)
		list(APPEND targets st_dep_${lower})
	endforeach()
	list(REMOVE_DUPLICATES targets)
	set(configurations ${CMAKE_CONFIGURATION_TYPES})
	if(NOT configurations)
		set(configurations "${CMAKE_BUILD_TYPE}")
	endif()
	if(NOT configurations)
		set(configurations Release)
	endif()
	set(settings "")
	set(any FALSE)
	foreach(config IN LISTS configurations)
		set(dirs)
		foreach(dependency IN LISTS targets)
			get_property(source TARGET ${dependency} PROPERTY ST_DEP_SOURCE)
			get_property(linkage TARGET ${dependency} PROPERTY ST_DEP_LINKAGE)
			if(source STREQUAL "BUNDLED" AND linkage STREQUAL "SHARED")
				get_property(prefix TARGET ${dependency} PROPERTY ST_DEP_PREFIX_${config})
				list(APPEND dirs "${prefix}/syncterm")
				set(any TRUE)
			endif()
		endforeach()
		string(APPEND settings "if(SYNCTERM_RUNTIME_CONFIG STREQUAL [==[${config}]==])\nset(runtime_dirs [==[${dirs}]==])\nendif()\n")
	endforeach()
	if(NOT any)
		return()
	endif()
	set(directory "${CMAKE_BINARY_DIR}/syncterm-generated")
	file(MAKE_DIRECTORY "${directory}")
	file(CONFIGURE OUTPUT "${directory}/runtime-settings.cmake" CONTENT "${settings}" @ONLY)
	add_custom_command(TARGET ${target} POST_BUILD
		COMMAND "${CMAKE_COMMAND}" "-DSYNCTERM_RUNTIME_CONFIG=$<CONFIG>"
			"-DSETTINGS=${directory}/runtime-settings.cmake" "-DDESTINATION=$<TARGET_FILE_DIR:${target}>"
			-P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/StageRuntime.cmake" VERBATIM)
	get_property(environment_added GLOBAL PROPERTY SYNCTERM_RUNTIME_TEST_ENVIRONMENT)
	if(NOT environment_added)
		list(GET configurations 0 default_config)
		set(environment "set(SYNCTERM_RUNTIME_CONFIG \"\${CTEST_CONFIGURATION_TYPE}\")\nif(NOT SYNCTERM_RUNTIME_CONFIG)\nset(SYNCTERM_RUNTIME_CONFIG [==[${default_config}]==])\nendif()\ninclude([==[${directory}/runtime-settings.cmake]==])\nlist(JOIN runtime_dirs \";\" runtime_path)\nset(ENV{PATH} \"\${runtime_path};\$ENV{PATH}\")\n")
		file(CONFIGURE OUTPUT "${directory}/runtime-test-environment.cmake" CONTENT "${environment}" @ONLY)
		set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY TEST_INCLUDE_FILES "${directory}/runtime-test-environment.cmake")
		set_property(GLOBAL PROPERTY SYNCTERM_RUNTIME_TEST_ENVIRONMENT TRUE)
	endif()
endfunction()
