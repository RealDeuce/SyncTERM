include("${CMAKE_CURRENT_LIST_DIR}/SynctermDependencies.cmake")

set(ST_DEP_SDL2_LINKED 0)
if(NOT ST_CONSOLE_SDL STREQUAL "OFF" AND NOT ((WIN32 OR APPLE) AND ST_CONSOLE_SDL STREQUAL "AUTO"))
	syncterm_dependency_options(SDL2 RUNTIME)
	set(linked_symbols)
	if(NOT ST_DEP_SDL2_MODE STREQUAL "RUNTIME")
		set(linked_symbols SDL_OpenURL SDL_GetDisplayUsableBounds SDL_GetWindowBordersSize)
	endif()
	set(required)
	if(ST_CONSOLE_SDL STREQUAL "ON")
		set(required REQUIRED)
	endif()
	st_console_dependency(SDL2 sdl2 SDL.h SDL2 RUNTIME ${required} SYMBOLS
		SDL_SetMainReady SDL_InitSubSystem SDL_QuitSubSystem SDL_Quit SDL_WasInit
		SDL_CreateWindow SDL_DestroyWindow SDL_GetWindowID SDL_GetWindowSize
		SDL_GetWindowDisplayIndex SDL_GetDisplayBounds SDL_SetWindowPosition
		SDL_SetWindowTitle SDL_SetWindowSize SDL_SetWindowMinimumSize SDL_RestoreWindow
		SDL_SetWindowFullscreen SDL_CreateRGBSurfaceFrom SDL_FreeSurface SDL_SetWindowIcon
		SDL_SetHint SDL_CreateRenderer SDL_DestroyRenderer SDL_GetRendererOutputSize
		SDL_SetRenderDrawColor SDL_RenderClear SDL_RenderCopy SDL_RenderPresent
		SDL_CreateTexture SDL_DestroyTexture SDL_LockTexture SDL_UnlockTexture SDL_PollEvent
		SDL_GetTicks SDL_ShowCursor SDL_CreateSystemCursor SDL_SetCursor SDL_FreeCursor
		SDL_StartTextInput SDL_StopTextInput SDL_SetClipboardText SDL_GetClipboardText SDL_free ${linked_symbols})
	if(ST_DEP_SDL2_TARGET)
		set(ST_CONSOLE_HAVE_SDL 1)
	endif()
else()
	set(ST_CONSOLE_HAVE_SDL 0)
endif()

foreach(dep X11 XRENDER XRANDR XINERAMA)
	set(ST_DEP_${dep}_LINKED 0)
endforeach()
if(NOT WIN32 AND NOT ST_CONSOLE_X11 STREQUAL "OFF" AND NOT (APPLE AND ST_CONSOLE_X11 STREQUAL "AUTO"))
	set(required)
	if(ST_CONSOLE_X11 STREQUAL "ON")
		set(required REQUIRED)
	endif()
	st_console_dependency(X11 x11 X11/Xlib.h X11 RUNTIME ${required} HEADERS X11/Xutil.h X11/XKBlib.h
		SYMBOLS XInitThreads XOpenDisplay XCloseDisplay XDefaultScreen XRootWindow XDefaultVisual
		XDefaultDepth XBlackPixel XConnectionNumber XCreateSimpleWindow XDestroyWindow XMapWindow
		XResizeWindow XStoreName XSelectInput XPending XNextEvent XFlush XSync XCreateGC XFreeGC
		XCreateImage XPutImage XFree XInternAtom XSetWMProtocols XGetWindowProperty
		XChangeProperty XDeleteProperty XConvertSelection XSetSelectionOwner XGetSelectionOwner XSendEvent)
	if(ST_DEP_X11_TARGET)
		set(ST_CONSOLE_HAVE_X11 1)
		foreach(pair "XRENDER|xrender|X11/extensions/Xrender.h|Xrender|XRenderQueryVersion"
			"XRANDR|xrandr|X11/extensions/Xrandr.h|Xrandr|XRRGetMonitors"
			"XINERAMA|xinerama|X11/extensions/Xinerama.h|Xinerama|XineramaQueryScreens")
			string(REPLACE "|" ";" fields "${pair}")
			list(GET fields 0 dep)
			list(GET fields 1 pkg)
			list(GET fields 2 header)
			list(GET fields 3 lib)
			list(GET fields 4 symbol)
			set(ST_CONSOLE_${dep} AUTO CACHE STRING "${dep} support: AUTO, ON, OFF")
			set_property(CACHE ST_CONSOLE_${dep} PROPERTY STRINGS AUTO ON OFF)
			if(NOT ST_CONSOLE_${dep} MATCHES "^(AUTO|ON|OFF)$")
				message(FATAL_ERROR "ST_CONSOLE_${dep} must be AUTO, ON, or OFF")
			endif()
			set(ST_CONSOLE_HAVE_${dep} 0)
			if(NOT ST_CONSOLE_${dep} STREQUAL "OFF")
				set(required)
				if(ST_CONSOLE_${dep} STREQUAL "ON")
					set(required REQUIRED)
				endif()
				st_console_dependency(${dep} ${pkg} ${header} ${lib} RUNTIME ${required} SYMBOLS ${symbol})
				if(ST_DEP_${dep}_TARGET)
					set(ST_CONSOLE_HAVE_${dep} 1)
				endif()
			endif()
		endforeach()
	endif()
else()
	set(ST_CONSOLE_HAVE_X11 0)
	set(ST_CONSOLE_HAVE_XRENDER 0)
	set(ST_CONSOLE_HAVE_XRANDR 0)
	set(ST_CONSOLE_HAVE_XINERAMA 0)
endif()


set(ST_CONSOLE_CURSES AUTO CACHE STRING "Curses support: AUTO, ON, OFF")
set_property(CACHE ST_CONSOLE_CURSES PROPERTY STRINGS AUTO ON OFF)
if(NOT ST_CONSOLE_CURSES MATCHES "^(AUTO|ON|OFF)$")
	message(FATAL_ERROR "ST_CONSOLE_CURSES must be AUTO, ON, or OFF")
endif()
set(ST_DEP_CURSES_LINKED 0)
set(ST_DEP_TERMINFO_LINKED 0)
set(default RUNTIME)
if(APPLE)
	set(default NATIVE)
endif()
if(NOT ST_CONSOLE_CURSES STREQUAL "OFF" AND (ST_CONSOLE_HAVE_CURSES_H OR ST_CONSOLE_CURSES STREQUAL "ON"))
	set(required)
	if(ST_CONSOLE_CURSES STREQUAL "ON")
		set(required REQUIRED)
	endif()
	st_console_dependency(CURSES ncursesw curses.h "ncursesw;ncurses;curses" ${default} ${required}
		HEADERS term.h SYMBOLS newterm delscreen endwin newwin delwin getmaxx getmaxy wmove waddch
		wrefresh werase cbreak raw noecho nonl keypad wtimeout scrollok curs_set has_colors
		can_change_color start_color color_content init_color init_pair tigetflag tigetnum tigetstr
		wattr_set wgetch)
	if(ST_DEP_CURSES_TARGET)
		get_property(pending TARGET ${ST_DEP_CURSES_TARGET} PROPERTY ST_DEP_PENDING)
		if(pending)
			set(ST_CONSOLE_HAVE_CURSES_H 1)
			set(ST_CONSOLE_HAVE_CURSES_TIMEOUT 1)
			set(ST_CONSOLE_HAVE_CURSES_WIDE 1)
			set(ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR 1)
			set(ST_CONSOLE_CURSES_IMPLEMENTATION ncurses)
		else()
			get_property(CMAKE_REQUIRED_INCLUDES TARGET ${ST_DEP_CURSES_TARGET} PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
			get_property(curses_options TARGET ${ST_DEP_CURSES_TARGET} PROPERTY INTERFACE_COMPILE_OPTIONS)
			list(JOIN curses_options " " CMAKE_REQUIRED_FLAGS)
			set(wide_probe "#include <curses.h>\n#include <wchar.h>\nint main(void) { int (*volatile add)(WINDOW *, const wchar_t *, int) = waddnwstr; return add == 0; }")
			set(extended_probe "#include <curses.h>\nint main(void) { int (*volatile content)(int, int *, int *, int *) = extended_color_content; int (*volatile init)(int, int, int, int) = init_extended_color; return content == 0 || init == 0; }")
			string(SHA256 signature "${CMAKE_REQUIRED_INCLUDES};${CMAKE_REQUIRED_FLAGS};${CMAKE_C_COMPILER};${ST_DEP_CURSES_LIBRARIES};${wide_probe};${extended_probe}")
			if(NOT ST_CURSES_PROBE_SIGNATURE STREQUAL signature)
				foreach(symbol use_extended_names resizeterm tiparm tputs use_legacy_coding alloc_pair find_pair mousemask mouseinterval getmouse)
					string(TOUPPER "${symbol}" upper)
					unset(ST_CURSES_HAVE_${upper} CACHE)
				endforeach()
				foreach(key ST_CONSOLE_CURSES_IS_NCURSES ST_CONSOLE_HAVE_CURSES_TIMEOUT ST_CONSOLE_HAVE_CURSES_WIDE ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR)
					unset(${key} CACHE)
				endforeach()
				set(ST_CURSES_PROBE_SIGNATURE "${signature}" CACHE INTERNAL "Selected curses probe context" FORCE)
			endif()
			# Re-evaluate ABI properties against the selected installation, not
			# an earlier platform/default header probe cached by the component.
			set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
			foreach(key ST_CONSOLE_CURSES_IS_NCURSES ST_CONSOLE_HAVE_CURSES_TIMEOUT
				ST_CONSOLE_HAVE_CURSES_WIDE ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR)
				unset(${key})
			endforeach()
			syncterm_check_c17_source("#include <curses.h>\n#ifndef NCURSES_VERSION\n#error Not ncurses\n#endif\nint main(void) { return 0; }" ST_CONSOLE_CURSES_IS_NCURSES)
			if(ST_CONSOLE_CURSES_IS_NCURSES)
				set(ST_CONSOLE_CURSES_IMPLEMENTATION ncurses)
			else()
				set(ST_CONSOLE_CURSES_IMPLEMENTATION non-ncurses)
			endif()
			syncterm_check_c17_source("#include <curses.h>\nint main(void) { void (*p)(WINDOW *, int) = wtimeout; return p == 0; }" ST_CONSOLE_HAVE_CURSES_TIMEOUT)
			syncterm_check_c17_source("${wide_probe}" ST_CONSOLE_HAVE_CURSES_WIDE)
			syncterm_check_c17_source("${extended_probe}" ST_CONSOLE_HAVE_CURSES_EXTENDED_COLOR)
		endif()
		foreach(symbol use_extended_names resizeterm tiparm tputs use_legacy_coding alloc_pair find_pair
			mousemask mouseinterval getmouse)
			string(TOUPPER "${symbol}" upper)
			if(pending)
				set(ST_CURSES_HAVE_${upper} 1)
			else()
				set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
				syncterm_check_c17_source("#include <curses.h>\n#include <term.h>\nint main(void) { void (*volatile p)(void) = (void (*)(void))${symbol}; return p == 0; }"
					ST_CURSES_HAVE_${upper})
			endif()
		endforeach()
		unset(CMAKE_REQUIRED_INCLUDES)
		unset(CMAKE_REQUIRED_FLAGS)
		unset(CMAKE_TRY_COMPILE_TARGET_TYPE)
	else()
		set(ST_CONSOLE_HAVE_CURSES_H 0)
		set(ST_CONSOLE_HAVE_CURSES_TIMEOUT 0)
	endif()
elseif(ST_CONSOLE_CURSES STREQUAL "OFF")
	set(ST_CONSOLE_HAVE_CURSES_H 0)
	set(ST_CONSOLE_HAVE_CURSES_TIMEOUT 0)
endif()

st_console_dependency(TERMINFO tinfo curses.h "tinfo;ncursesw;ncurses;curses" ${default}
	HEADERS term.h SYMBOLS setupterm tigetnum tigetflag)

# Legacy header discovery above decides whether native build tools/protocols
# exist. Compilation must use the installation selected by the resolver.
foreach(pair "SDL2|ST_CONSOLE_SDL_INCLUDE_DIRS" "X11|ST_CONSOLE_X11_INCLUDE_DIRS")
	string(REPLACE "|" ";" fields "${pair}")
	list(GET fields 0 dep)
	list(GET fields 1 variable)
	set(${variable})
	if(ST_DEP_${dep}_TARGET)
		get_property(${variable} TARGET ${ST_DEP_${dep}_TARGET} PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
	endif()
endforeach()
set(ST_CONSOLE_WAYLAND_INCLUDE_DIRS)
foreach(dep WAYLAND XKBCOMMON)
	if(ST_DEP_${dep}_TARGET)
		get_property(includes TARGET ${ST_DEP_${dep}_TARGET} PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
		list(APPEND ST_CONSOLE_WAYLAND_INCLUDE_DIRS ${includes})
	endif()
endforeach()
