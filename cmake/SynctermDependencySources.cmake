include_guard(GLOBAL)
include(ExternalProject)
include("${CMAKE_CURRENT_LIST_DIR}/dependencies/Recipes.cmake")
if(POLICY CMP0135)
	cmake_policy(SET CMP0135 NEW)
endif()

function(syncterm_dependency_source name mode requested_libraries)
	if(name STREQUAL "PIPEWIRE" AND mode STREQUAL "STATIC")
		message(FATAL_ERROR "Pinned PipeWire requires SHARED: its protocol/SPA modules share the client library's global state. Use an installed static package with its complete module/link contract, or select SHARED.")
	endif()
	if(name STREQUAL "PIPEWIRE")
		syncterm_check_c17_source("#include <errno.h>\nint main(void) { return ECHRNG; }" ST_DEP_PIPEWIRE_HAVE_ECHRNG)
		syncterm_check_c17_source("#include <errno.h>\nint main(void) { return EBADFD; }" ST_DEP_PIPEWIRE_HAVE_EBADFD)
	endif()
	if(name MATCHES "^(BOTAN|JXL|HIGHWAY|FLUIDSYNTH|ADLMIDI|GCEM)$")
		enable_language(CXX)
	endif()
	syncterm_dependency_recipe(${name})
	set(kind "${recipe_kind}")
	set(libraries "${recipe_libs}")
	set(include_suffix "${recipe_include_suffix}")
	set(options "${recipe_options}")
	set(deps "${recipe_deps}")
	set(system_prefixes)
	if(name STREQUAL "PIPEWIRE" OR name STREQUAL "PULSEAUDIO")
		find_package(Intl REQUIRED)
		foreach(directory IN LISTS Intl_INCLUDE_DIRS)
			get_filename_component(system_prefix "${directory}" DIRECTORY)
			list(APPEND system_prefixes "${system_prefix}")
		endforeach()
	endif()
	set(lock_name "${name}")
	if(name STREQUAL "TERMINFO" OR name STREQUAL "CURSES")
		set(lock_name NCURSES)
	endif()
	file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/lock.json" lock)
	foreach(field version url sha256)
		string(JSON ${field} GET "${lock}" dependencies ${lock_name} ${field})
	endforeach()
	set(source_url "${url}")
	if(ST_DEP_${name}_ARCHIVE)
		set(source_url "${ST_DEP_${name}_ARCHIVE}")
	elseif(NOT SYNCTERM_DEPENDENCY_DOWNLOADS)
		set(source_url "${SYNCTERM_DEPENDENCY_CACHE}/${lock_name}-${version}.tar")
		if(NOT EXISTS "${source_url}")
			message(FATAL_ERROR "Offline ${name} build needs ${source_url} or ST_DEP_${name}_ARCHIVE")
		endif()
	endif()
	set(dep_targets)
	set(dep_prefixes)
	set(dep_definitions)
	foreach(dep IN LISTS deps)
		syncterm_dependency_recipe(${dep})
		set(cxx)
		if(dep STREQUAL "HIGHWAY" OR dep STREQUAL "GCEM")
			set(cxx CXX)
		endif()
		syncterm_dependency(NAME ${dep} PACKAGE "${recipe_package}" HEADER "${recipe_header}"
			LIBRARIES ${recipe_libs} DEFAULT SHARED REQUIRED LINK_REQUIRED ${cxx}
			PROBE "#include <${recipe_header}>\nint main(void) { return 0; }")
		list(APPEND dep_targets ${ST_DEP_${dep}_TARGET})
		get_property(dep_options TARGET ${ST_DEP_${dep}_TARGET} PROPERTY INTERFACE_COMPILE_OPTIONS)
		foreach(option IN LISTS dep_options)
			if(option MATCHES "^-D")
				list(APPEND dep_definitions "${option}")
			endif()
		endforeach()
		get_property(prefix TARGET ${ST_DEP_${dep}_TARGET} PROPERTY ST_DEP_PREFIX)
		if(prefix)
			list(APPEND dep_prefixes "${prefix}")
		else()
			get_property(includes TARGET ${ST_DEP_${dep}_TARGET} PROPERTY ST_DEP_INCLUDE)
			get_filename_component(prefix "${includes}" DIRECTORY)
			list(APPEND dep_prefixes "${prefix}")
		endif()
	endforeach()
	string(TOLOWER "${name}" lower)
	set(target st_dep_${lower})
	if(DEP_LINK_REQUIRED AND ST_DEP_${name}_MODE STREQUAL "RUNTIME")
		set(target st_dep_${lower}_link)
	endif()
	add_library(${target} INTERFACE)
	syncterm_dependency_math(${target})
	if(name MATCHES "^(BOTAN|JXL|HIGHWAY|FLUIDSYNTH|ADLMIDI)$")
		target_link_libraries(${target} INTERFACE ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
		target_link_directories(${target} INTERFACE ${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES})
	endif()
	if(CMAKE_CONFIGURATION_TYPES)
		set(configurations ${CMAKE_CONFIGURATION_TYPES})
	else()
		set(configurations "${CMAKE_BUILD_TYPE}")
		if(NOT configurations)
			set(configurations Release)
		endif()
	endif()
	set(binary_root "${CMAKE_BINARY_DIR}/dependencies/build/${lower}-${version}")
	set(build_target st_build_${lower})
	set(build_deps)
	set(build_products)
	foreach(config IN LISTS configurations)
		set(prefix "${CMAKE_BINARY_DIR}/dependencies/${lower}-${version}/${config}")
		set_property(TARGET ${target} PROPERTY ST_DEP_PREFIX_${config} "${prefix}")
		set(dep_prefixes ${system_prefixes})
		foreach(dep_target IN LISTS dep_targets)
			get_property(dep_prefix TARGET ${dep_target} PROPERTY ST_DEP_PREFIX_${config})
			if(NOT dep_prefix)
				get_property(dep_prefix TARGET ${dep_target} PROPERTY ST_DEP_PREFIX)
			endif()
			if(dep_prefix)
				list(APPEND dep_prefixes "${dep_prefix}")
			endif()
		endforeach()
		set(binary "${binary_root}/work/${config}")
		set(config_file "${binary_root}/settings/${config}.cmake")
		file(MAKE_DIRECTORY "${binary}" "${binary_root}/settings" "${prefix}/include" "${prefix}/syncterm")
		if(include_suffix)
			file(MAKE_DIRECTORY "${prefix}/include/${include_suffix}")
		endif()
		set(settings "# Generated dependency toolchain/configuration.\n")
		if(CMAKE_TOOLCHAIN_FILE AND NOT IS_ABSOLUTE "${CMAKE_TOOLCHAIN_FILE}")
			if(EXISTS "${CMAKE_BINARY_DIR}/${CMAKE_TOOLCHAIN_FILE}")
				get_filename_component(CMAKE_TOOLCHAIN_FILE "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
			else()
				get_filename_component(CMAKE_TOOLCHAIN_FILE "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
			endif()
		endif()
		foreach(key CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_AR CMAKE_RANLIB CMAKE_STRIP
			CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SYSROOT
			CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
			CMAKE_TOOLCHAIN_FILE CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR CMAKE_FIND_ROOT_PATH
			CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ${CMAKE_TRY_COMPILE_PLATFORM_VARIABLES}
			CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET CMAKE_MSVC_RUNTIME_LIBRARY
			CMAKE_C_COMPILER_ID CMAKE_CXX_COMPILER_ID CMAKE_SIZEOF_VOID_P
			CMAKE_C_COMPILER_ARCHITECTURE_ID CMAKE_CXX_COMPILER_ARCHITECTURE_ID
			CMAKE_HOST_SYSTEM_NAME CMAKE_HOST_SYSTEM_PROCESSOR CMAKE_CROSSCOMPILING CMAKE_C_BYTE_ORDER
			CMAKE_GENERATOR CMAKE_GENERATOR_PLATFORM CMAKE_GENERATOR_TOOLSET WIN32 APPLE MSVC)
			string(APPEND settings "set(${key} [==[${${key}}]==])\n")
		endforeach()
		foreach(key name mode kind prefix binary config libraries options dep_prefixes dep_definitions include_suffix)
			string(APPEND settings "set(${key} [==[${${key}}]==])\n")
		endforeach()
		if(CMAKE_CONFIGURATION_TYPES)
			file(GENERATE OUTPUT "${config_file}" CONTENT "${settings}" CONDITION "$<CONFIG:${config}>")
		else()
			file(GENERATE OUTPUT "${config_file}" CONTENT "${settings}")
		endif()
		set(products)
		set(static_suffix .a)
		if(MSVC)
			set(static_suffix .lib)
		endif()
		foreach(library IN LISTS libraries)
			if(mode STREQUAL "STATIC")
				set(product "${prefix}/syncterm/lib${library}${static_suffix}")
			else()
				set(product "${prefix}/syncterm/lib${library}${CMAKE_SHARED_LIBRARY_SUFFIX}")
			endif()
			list(APPEND products "${product}")
			if(WIN32 AND NOT mode STREQUAL "STATIC")
				list(APPEND products "${product}${static_suffix}")
			endif()
		endforeach()
		foreach(product IN LISTS products)
			if(CMAKE_CONFIGURATION_TYPES)
				list(APPEND build_products "$<$<CONFIG:${config}>:${product}>")
			else()
				list(APPEND build_products "${product}")
			endif()
		endforeach()
		foreach(dep_target IN LISTS dep_targets)
			get_property(dep_builds TARGET ${dep_target} PROPERTY ST_DEP_BUILD_TARGETS_${config})
			list(APPEND build_deps ${dep_builds})
		endforeach()
		set_property(TARGET ${target} PROPERTY ST_DEP_BUILD_TARGETS_${config} "${build_target}")
		set(include_dirs "${prefix}/include")
		if(include_suffix)
			list(PREPEND include_dirs "${prefix}/include/${include_suffix}")
		endif()
		if(name STREQUAL "PIPEWIRE")
			file(MAKE_DIRECTORY "${prefix}/include/spa-0.2")
			list(APPEND include_dirs "${prefix}/include/spa-0.2")
		endif()
		# Provider consumers such as DeuceSSH also inspect this target's own
		# include property. Keep that property valid for pending source builds.
		foreach(directory IN LISTS include_dirs)
			if(CMAKE_CONFIGURATION_TYPES)
				target_include_directories(${target} SYSTEM INTERFACE "$<$<CONFIG:${config}>:${directory}>")
			else()
				target_include_directories(${target} SYSTEM INTERFACE "${directory}")
			endif()
		endforeach()
		set(config_target st_dep_${lower}_${config})
		add_library(${config_target} INTERFACE)
		add_dependencies(${config_target} ${build_target})
		target_include_directories(${config_target} SYSTEM INTERFACE ${include_dirs})
		if(NOT mode STREQUAL "RUNTIME")
			foreach(product IN LISTS products)
				if(product MATCHES "\\.dll\\.(a|lib)$")
					continue()
				endif()
				string(SHA256 id "${product}")
				if(mode STREQUAL "STATIC")
					add_library(st_product_${id} STATIC IMPORTED GLOBAL)
				else()
					add_library(st_product_${id} SHARED IMPORTED GLOBAL)
				endif()
				set_property(TARGET st_product_${id} PROPERTY IMPORTED_LOCATION "${product}")
				if(WIN32 AND NOT mode STREQUAL "STATIC")
					set_property(TARGET st_product_${id} PROPERTY IMPORTED_IMPLIB "${product}${static_suffix}")
				endif()
				add_dependencies(st_product_${id} ${build_target})
				target_link_libraries(${config_target} INTERFACE st_product_${id})
			endforeach()
			target_link_libraries(${config_target} INTERFACE ${dep_targets})
		endif()
		if(CMAKE_CONFIGURATION_TYPES)
			target_link_libraries(${target} INTERFACE "$<$<CONFIG:${config}>:${config_target}>")
		else()
			target_link_libraries(${target} INTERFACE ${config_target})
		endif()
	endforeach()
	# One build target follows the generator's active configuration. Separate
	# per-config utility targets can order compilation after the wrong install.
	if(CMAKE_CONFIGURATION_TYPES)
		set(active_config "$<CONFIG>")
	else()
		list(GET configurations 0 active_config)
	endif()
	set(active_settings "${binary_root}/settings/${active_config}.cmake")
	set(active_source "${binary_root}/source/${active_config}")
	set(active_work "${binary_root}/work/${active_config}")
	list(REMOVE_DUPLICATES build_deps)
	ExternalProject_Add(${build_target}
		DOWNLOAD_COMMAND "${CMAKE_COMMAND}" "-DSOURCE_URL=${source_url}" "-DSHA256=${sha256}"
			"-DCACHE_FILE=${SYNCTERM_DEPENDENCY_CACHE}/${lock_name}-${version}.tar"
			"-DDOWNLOADS=${SYNCTERM_DEPENDENCY_DOWNLOADS}" "-DDESTINATION=${active_source}"
			-P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Fetch.cmake"
		PREFIX "${binary_root}/external" SOURCE_DIR "${binary_root}/source"
		BINARY_DIR "${binary_root}/work" INSTALL_DIR "${CMAKE_BINARY_DIR}/dependencies/${lower}-${version}"
		PATCH_COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${active_source}" "-DNAME=${name}" "-DMODE=${mode}"
			"-DHAVE_ECHRNG=${ST_DEP_PIPEWIRE_HAVE_ECHRNG}"
			"-DHAVE_EBADFD=${ST_DEP_PIPEWIRE_HAVE_EBADFD}"
			-P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Patch.cmake"
		CONFIGURE_COMMAND "${CMAKE_COMMAND}" "-DSETTINGS=${active_settings}" "-DSOURCE=${active_source}"
			"-DWORK=${active_work}" -DSTEP=configure -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Build.cmake"
		BUILD_COMMAND "${CMAKE_COMMAND}" "-DSETTINGS=${active_settings}" "-DSOURCE=${active_source}"
			"-DWORK=${active_work}" -DSTEP=build -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Build.cmake"
		INSTALL_COMMAND "${CMAKE_COMMAND}" "-DSETTINGS=${active_settings}" "-DSOURCE=${active_source}"
			"-DWORK=${active_work}" -DSTEP=install -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Build.cmake"
		BUILD_BYPRODUCTS ${build_products} DEPENDS ${build_deps}
		LOG_DOWNLOAD ON LOG_CONFIGURE ON LOG_BUILD ON LOG_INSTALL ON
		LOG_OUTPUT_ON_FAILURE ON EXCLUDE_FROM_ALL TRUE)
	ExternalProject_Add_Step(${build_target} configuration_inputs
		COMMAND "${CMAKE_COMMAND}" -E true DEPENDEES patch DEPENDERS configure
		DEPENDS "${active_settings}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Build.cmake"
			"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Recipes.cmake"
			"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Patch.cmake"
			"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/lock.json")
	ExternalProject_Add_Step(${build_target} patch_inputs
		COMMAND "${CMAKE_COMMAND}" -E true DEPENDEES update DEPENDERS patch
		INDEPENDENT TRUE
		DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Patch.cmake")
	ExternalProject_Add_Step(${build_target} fetch_inputs
		COMMAND "${CMAKE_COMMAND}" -E true DEPENDEES mkdir DEPENDERS download
		INDEPENDENT TRUE
		DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/Fetch.cmake")
	set_target_properties(${target} PROPERTIES ST_DEP_LINKAGE "${mode}"
		ST_DEP_SOURCE BUNDLED ST_DEP_VERSION "${version}" ST_DEP_PATH "${prefix}"
		ST_DEP_INCLUDE "${include_dirs}" ST_DEP_PREFIX "${prefix}" ST_DEP_PENDING TRUE
		ST_DEP_BUILD_CONFIGURATIONS "${configurations}")
	if(name STREQUAL "PIPEWIRE" OR name STREQUAL "PULSEAUDIO")
		target_link_libraries(${target} INTERFACE Intl::Intl)
	endif()
	if(name MATCHES "^(BOTAN|OPENSSL|FLUIDSYNTH|ALSA|SDL2|PORTAUDIO|PULSEAUDIO|PIPEWIRE|WAYLAND|X11)$")
		set(THREADS_PREFER_PTHREAD_FLAG TRUE)
		find_package(Threads REQUIRED)
		target_link_libraries(${target} INTERFACE Threads::Threads)
	endif()
	if(name MATCHES "^(BOTAN|OPENSSL|ALSA|SDL2|PULSEAUDIO|PIPEWIRE)$")
		target_link_libraries(${target} INTERFACE ${CMAKE_DL_LIBS})
	endif()
	if(name STREQUAL "OPENSSL" AND WIN32)
		target_link_libraries(${target} INTERFACE ws2_32 crypt32 bcrypt)
	endif()
	if(name STREQUAL "MPG123" AND WIN32)
		target_link_libraries(${target} INTERFACE shlwapi)
	endif()
	if(name STREQUAL "SDL2" OR name STREQUAL "PORTAUDIO")
		if(APPLE)
			set(frameworks CoreAudio AudioToolbox AudioUnit CoreFoundation)
			if(name STREQUAL "SDL2")
				list(APPEND frameworks Cocoa IOKit CoreVideo ForceFeedback Carbon Metal QuartzCore GameController CoreHaptics)
			endif()
			foreach(framework IN LISTS frameworks)
				unset(location)
				find_library(location NAMES "${framework}" NO_CACHE)
				if(location)
					target_link_libraries(${target} INTERFACE "${location}")
				endif()
			endforeach()
		elseif(WIN32)
			target_link_libraries(${target} INTERFACE user32 winmm ole32 oleaut32 uuid setupapi)
			if(name STREQUAL "SDL2")
				target_link_libraries(${target} INTERFACE gdi32 imm32 version shell32 advapi32)
			else()
				target_link_libraries(${target} INTERFACE ksuser)
			endif()
		endif()
	endif()
	if(name STREQUAL "BOTAN")
		if(APPLE)
			find_library(security Security REQUIRED)
			find_library(corefoundation CoreFoundation REQUIRED)
			target_link_libraries(${target} INTERFACE "${security}" "${corefoundation}")
		elseif(WIN32)
			target_link_libraries(${target} INTERFACE crypt32 bcrypt ws2_32)
		else()
			target_link_libraries(${target} INTERFACE ${CMAKE_DL_LIBS})
		endif()
	endif()
	get_property(native_links TARGET ${target} PROPERTY INTERFACE_LINK_LIBRARIES)
	foreach(config IN LISTS configurations)
		list(REMOVE_ITEM native_links "${config_target}")
		list(FILTER native_links EXCLUDE REGEX "st_dep_${lower}_")
		set(config_target st_dep_${lower}_${config})
		get_property(config_links TARGET ${config_target} PROPERTY INTERFACE_LINK_LIBRARIES)
		set_property(TARGET ${config_target} PROPERTY INTERFACE_LINK_LIBRARIES "")
		syncterm_dependency_link_libraries(${config_target} ${mode} ${config_links} ${native_links})
	endforeach()
endfunction()
