# Model ccache's documented XDG_RUNTIME_DIR default without requiring it on
# the test host. The compiler itself still runs normally.
set -eu
ci_cache_tmp=${CCACHE_TEMPDIR:-"$XDG_RUNTIME_DIR/ccache-tmp"}
mkdir -p "$ci_cache_tmp"
printf 'invoked\n' >>"$ci_cache_tmp/fixture-invocations.log"
exec "$@"
