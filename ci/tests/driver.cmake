cmake_minimum_required(VERSION 3.22)
get_filename_component(_ci "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TEST_ROOT)
	message(FATAL_ERROR "TEST_ROOT is required")
endif()

function(check_case name failure extra profile)
	set(_build "${TEST_ROOT}/${name}")
	# Simulate inherited artifacts and a retry of a previously successful job.
	file(MAKE_DIRECTORY "${_build}/reports" "${_build}/artifacts")
	file(WRITE "${_build}/reports/junit.xml" "stale result")
	file(WRITE "${_build}/reports/asan.stale.123" "stale sanitizer result")
	file(WRITE "${_build}/artifacts/syncterm-stale" "stale binary")
	execute_process(COMMAND "${CMAKE_COMMAND}" -E env
		"CI_EXTRA_CMAKE_ARGS=${extra}" "CMAKE_BUILD_PARALLEL_LEVEL=2"
		"CTEST_PARALLEL_LEVEL=1"
		"${CMAKE_COMMAND}" "-DCI_SOURCE_DIR=${CMAKE_CURRENT_LIST_DIR}/fixture"
		"-DCI_BUILD_DIR=${_build}" "-DCI_PROFILE=${profile}"
		-P "${_ci}/run.cmake"
		RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
	if(failure STREQUAL "")
		if(NOT "${_result}" STREQUAL "0")
			message(FATAL_ERROR "${name}: ${_out}\n${_err}")
		endif()
		file(READ "${_build}/reports/junit.xml" _junit)
		if(NOT _junit MATCHES "fixture_unavailable" OR NOT _junit MATCHES "skipped")
			message(FATAL_ERROR "${name}: skipped test was lost from JUnit")
		endif()
		file(GLOB _app "${_build}/artifacts/syncterm*")
		if(NOT _app)
			message(FATAL_ERROR "${name}: missing application artifact")
		endif()
		list(LENGTH _app _product_count)
		if(NOT _product_count EQUAL 2)
			message(FATAL_ERROR "${name}: application/core artifact manifest was not copied")
		endif()
	else()
		if("${_result}" STREQUAL "0" OR NOT "${_out}\n${_err}" MATCHES "CI ${failure} failed")
			message(FATAL_ERROR "${name}: expected ${failure} failure, got ${_result}\n${_out}\n${_err}")
		endif()
		if(NOT EXISTS "${_build}/reports/${failure}.log")
			message(FATAL_ERROR "${name}: failure log was not retained")
		endif()
		if((failure STREQUAL configure OR failure STREQUAL build)
		    AND EXISTS "${_build}/reports/junit.xml")
			message(FATAL_ERROR "${name}: published stale test results")
		endif()
		if(failure STREQUAL configure AND NOT EXISTS "${_build}/reports/CMakeError.log")
			message(FATAL_ERROR "${name}: lost failed probe diagnostics")
		endif()
	endif()
	if(EXISTS "${_build}/artifacts/syncterm-stale")
		message(FATAL_ERROR "${name}: published a stale binary")
	endif()
	if(EXISTS "${_build}/reports/asan.stale.123")
		message(FATAL_ERROR "${name}: published a stale sanitizer report")
	endif()
endfunction()

check_case(success "" "" native)
check_case(success "" "-DBUILD_TESTING:STRING=true" native)
check_case(minimal "" "" minimal)
file(STRINGS "${TEST_ROOT}/minimal/CMakeCache.txt" _crypto REGEX "^CRYPTO_BACKEND:")
if(NOT _crypto STREQUAL "CRYPTO_BACKEND:UNINITIALIZED=none")
	message(FATAL_ERROR "Minimal profile failed to disable crypto")
endif()
check_case(configure-failure configure "-DCI_FIXTURE_CONFIGURE_FAIL=ON" native)
check_case(build-failure build "-DCI_FIXTURE_BUILD_FAIL=ON" native)
check_case(test-failure test "-DCI_FIXTURE_TEST_FAIL=ON" native)
check_case(no-tests test "-DCI_FIXTURE_NO_TESTS=ON" native)

function(check_artifact_failure name option reason)
	set(_build "${TEST_ROOT}/${name}")
	execute_process(COMMAND "${CMAKE_COMMAND}" -E env
		"CI_EXTRA_CMAKE_ARGS=-D${option}=ON" "CMAKE_BUILD_PARALLEL_LEVEL=2"
		"${CMAKE_COMMAND}" "-DCI_SOURCE_DIR=${CMAKE_CURRENT_LIST_DIR}/fixture"
		"-DCI_BUILD_DIR=${_build}" -DCI_PROFILE=native
		-P "${_ci}/run.cmake"
		RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
	if("${_result}" STREQUAL "0" OR NOT "${_out}\n${_err}" MATCHES "${reason}")
		message(FATAL_ERROR "${name}: expected artifact failure, got ${_result}\n${_out}\n${_err}")
	endif()
	file(GLOB _products "${_build}/artifacts/*")
	if(_products)
		message(FATAL_ERROR "${name}: published an incomplete product set")
	endif()
endfunction()
check_artifact_failure(missing-manifest CI_FIXTURE_MISSING_MANIFEST "missing application manifest")
check_artifact_failure(empty-manifest CI_FIXTURE_EMPTY_MANIFEST "empty application manifest")
check_artifact_failure(missing-product CI_FIXTURE_MISSING_PRODUCT "application product was not built")

# Exercise configuration-specific bin paths when this generator is available.
find_program(_ninja ninja)
if(_ninja)
	set(_saved_generator "$ENV{CMAKE_GENERATOR}")
	set(ENV{CMAKE_GENERATOR} "Ninja Multi-Config")
	check_case(multi-config "" "" native)
	set(ENV{CMAKE_GENERATOR} "${_saved_generator}")
endif()

# Pinning and architecture information must exist for both Windows jobs.
file(READ "${_ci}/mingw-toolchains.json" _manifest)
foreach(_arch IN ITEMS x86 x64)
	string(JSON _hash GET "${_manifest}" ${_arch} sha256)
	string(LENGTH "${_hash}" _hash_length)
	if(NOT _hash_length EQUAL 64 OR NOT _hash MATCHES "^[0-9a-f]+$")
		message(FATAL_ERROR "Invalid pinned MinGW SHA256 for ${_arch}")
	endif()
	string(JSON _archive GET "${_manifest}" ${_arch} archive)
	if(NOT _archive MATCHES "^winlibs-.*-posix-.*-gcc-.*mingw-w64ucrt-.*\\.zip$")
		message(FATAL_ERROR "Unexpected MinGW archive: ${_archive}")
	endif()
endforeach()
message(STATUS "CI driver success, failure propagation, empty suites, skips and manifests verified")
