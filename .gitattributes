# Preserve exact upstream bytes checked by emoji data and license pins.
src/text/emoji/data/*.txt -text
src/text/emoji/LICENSE.CLDR -text
# Preserve pinned Amiga font bytes, including upstream whitespace.
src/media/amiga_font/data/*.yaff -text -whitespace
src/media/amiga_font/data/LICENSE-MIT -text
# Preserve pinned RIPtel font payloads, not Git LFS pointers.
src/terminal/rip3/assets/fonts/*.RFF -text
src/terminal/rip3/assets/fonts/*.maf -text
src/terminal/rip3/assets/fonts/*.CHR -text
# Preserve original reference icon bytes used only by RIP3 conversion tests.
src/terminal/rip3/tests/assets/legacy-icons/*.ICN -text
src/terminal/rip3/tests/assets/legacy-icons/*.BMP -text
# Independently constructed JPEG test bitstreams and upstream notices.
src/media/pixel_image/tests/jpeg/*.jpg -text
src/media/pixel_image/LICENSE.JPEG -text
